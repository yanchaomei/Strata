// ascend/src/kernels/ascend_ops.asc - Custom Ascend C (dav-m200 / Ascend310P3) AI Core kernels for Qwen3.8-Flash-Next.
//
// Design principles for Ascend310P3 (dav-m200, 8 AI Cores, 256 KB UB per core):
// 1. Every GM <-> UB DataCopy uses sizes & byte offsets strictly divisible by 32 bytes.
// 2. Explicit PipeBarrier<PIPE_ALL>() guards transitions between MTE2, PIPE_V, PIPE_S, and MTE3 on TBuf<VECCALC>.
// 3. Peak UB allocation in every kernel stays <= 160 KB (< 256 KB hardware limit).
// 4. All reductions, norms, GDN recurrence, QSA online softmax, and Q2_0 expert dot products accumulate in FP32.

#include "kernel_operator.h"

namespace {

constexpr uint32_t kNumCores = 8;

// P_* layout constants matching ascend_ops.h
constexpr int P_NG = 0;
constexpr int P_IGU = 4;
constexpr int P_IDN = 8;
constexpr int P_MAXE = 128;
constexpr int P_GEXP = 16;
constexpr int P_GSTART = P_GEXP + P_MAXE;        // 144
constexpr int P_ETOK = P_GSTART + P_MAXE + 8;    // 280
constexpr int P_EW = P_ETOK + P_MAXE;            // 408
constexpr int P_TOKENT = P_EW + P_MAXE;          // 536
constexpr int P_INTS = P_TOKENT + P_MAXE + 8;    // 672

__aicore__ inline float fast_expf(float x) {
    // IEEE-accurate exp via scalar math or polynomial? Wait: on dav-m200 scalar unit, let's check math builtins or
    // use UB 8-element AscendC::Exp! Even better: a 6-term range-reduced expf in IEEE float32 has < 1e-7 relative error
    // and zero library call dependencies on AICore scalar unit!
    if (x > 88.0f) x = 88.0f;
    if (x < -88.0f) x = -88.0f;
    // x = k * ln(2) + r, |r| <= ln(2)/2
    const float inv_ln2 = 1.4426950408889634f;
    const float ln2_hi = 0.693145751953125f;
    const float ln2_lo = 1.428606765330187e-06f;
    float kf = x * inv_ln2;
    int k = (int)(kf >= 0.0f ? (kf + 0.5f) : (kf - 0.5f));
    kf = (float)k;
    float r = (x - kf * ln2_hi) - kf * ln2_lo;
    // Remez minimax degree-6 for exp(r) on [-0.3466, 0.3466]
    float p = 1.38888889e-3f;
    p = p * r + 8.33333333e-3f;
    p = p * r + 4.16666667e-2f;
    p = p * r + 1.66666667e-1f;
    p = p * r + 5.00000000e-1f;
    p = p * r + 1.0f;
    p = p * r + 1.0f;
    uint32_t bits = (uint32_t)(k + 127) << 23;
    union { uint32_t u; float f; } scale;
    scale.u = bits;
    return p * scale.f;
}

__aicore__ inline float fast_logf(float x) {
    if (x <= 0.0f) return -1e30f;
    union { float f; uint32_t u; } v;
    v.f = x;
    int e = (int)((v.u >> 23) & 0xFFu) - 127;
    v.u = (v.u & 0x007FFFFFu) | 0x3F800000u;
    float m = v.f;
    if (m > 1.41421356f) { m *= 0.5f; e += 1; }
    float t = (m - 1.0f) / (m + 1.0f);
    float t2 = t * t;
    float p = 0.2857142857f;
    p = p * t2 + 0.4000000000f;
    p = p * t2 + 0.6666666667f;
    p = p * t2 + 2.0f;
    return (float)e * 0.6931471805599453f + t * p;
}

__aicore__ inline float fast_sqrtf(float x) {
    if (x <= 0.0f) return 0.0f;
    union { float f; uint32_t u; } v;
    v.f = x;
    v.u = 0x5f3759dfu - (v.u >> 1);
    float y = v.f;
    y = y * (1.5f - 0.5f * x * y * y);
    y = y * (1.5f - 0.5f * x * y * y);
    y = y * (1.5f - 0.5f * x * y * y);
    return x * y;
}

__aicore__ inline float fast_rsqrtf(float x) {
    union { float f; uint32_t u; } v;
    v.f = x;
    v.u = 0x5f3759dfu - (v.u >> 1);
    float y = v.f;
    y = y * (1.5f - 0.5f * x * y * y);
    y = y * (1.5f - 0.5f * x * y * y);
    y = y * (1.5f - 0.5f * x * y * y);
    return y;
}

__aicore__ inline float fast_sigmoid(float x) {
    return 1.0f / (1.0f + fast_expf(-x));
}

__aicore__ inline float fast_silu(float x) {
    return x / (1.0f + fast_expf(-x));
}

__aicore__ inline float half_to_float_scalar(uint16_t h) {
    uint32_t sign = (uint32_t)(h >> 15) & 1u;
    uint32_t exp = (h >> 10) & 0x1Fu;
    uint32_t man = h & 0x3FFu;
    uint32_t f = 0;
    if (exp == 0) {
        if (man == 0) {
            f = sign << 31;
        } else {
            exp = 127 - 15 + 1;
            while (!(man & 0x400u)) { man <<= 1; --exp; }
            man &= 0x3FFu;
            f = (sign << 31) | (exp << 23) | (man << 13);
        }
    } else if (exp == 31) {
        f = (sign << 31) | 0x7F800000u | (man << 13);
    } else {
        f = (sign << 31) | ((exp - 15 + 127) << 23) | (man << 13);
    }
    union { uint32_t u; float fl; } u;
    u.u = f;
    return u.fl;
}

__aicore__ inline uint16_t float_to_half_scalar(float fl) {
    union { float f; uint32_t u; } v;
    v.f = fl;
    uint32_t x = v.u;
    uint32_t sign = (x >> 16) & 0x8000u;
    int32_t exp = (int32_t)((x >> 23) & 0xFFu) - 127 + 15;
    uint32_t man = x & 0x7FFFFFu;
    if (exp <= 0) {
        if (exp < -10) return (uint16_t)sign;
        man |= 0x800000u;
        uint32_t shift = (uint32_t)(14 - exp);
        uint32_t half_man = man >> shift;
        uint32_t rem = man & ((1u << shift) - 1u);
        uint32_t mid = 1u << (shift - 1u);
        if (rem > mid || (rem == mid && (half_man & 1u))) ++half_man;
        return (uint16_t)(sign | half_man);
    } else if (exp >= 31) {
        return (uint16_t)(sign | 0x7C00u);
    }
    uint32_t half_man = man >> 13;
    uint32_t rem = man & 0x1FFFu;
    if (rem > 0x1000u || (rem == 0x1000u && (half_man & 1u))) {
        ++half_man;
        if (half_man == 0x400u) { half_man = 0; ++exp; if (exp >= 31) return (uint16_t)(sign | 0x7C00u); }
    }
    return (uint16_t)(sign | ((uint32_t)exp << 10) | half_man);
}

__aicore__ inline int rint_clamp_i8(float v) {
    // Round to nearest even, clamp [-127, 127]
    int sign = v < 0.0f ? -1 : 1;
    float av = v < 0.0f ? -v : v;
    int fl = (int)av;
    float rem = av - (float)fl;
    if (rem > 0.5f || (rem == 0.5f && (fl & 1))) ++fl;
    int res = sign * fl;
    if (res > 127) res = 127;
    if (res < -127) res = -127;
    return res;
}

__aicore__ inline uint32_t float_okey(float f) {
    union { float fl; uint32_t u; } v;
    v.fl = f;
    return (v.u & 0x80000000u) ? ~v.u : (v.u | 0x80000000u);
}

}  // namespace

// ============================================================================
// 1. Cast kernels: f32 <-> f16 (n must be multiple of 16)
// ============================================================================
extern "C" __global__ __aicore__ void asc_f32_to_f16_kern(GM_ADDR src, GM_ADDR dst, uint32_t n) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    AscendC::GlobalTensor<float> gs; gs.SetGlobalBuffer((__gm__ float*)src, n);
    AscendC::GlobalTensor<half> gd;  gd.SetGlobalBuffer((__gm__ half*)dst, n);

    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> b32, b16;
    constexpr uint32_t TILE = 4096;
    pipe.InitBuffer(b32, TILE * sizeof(float));
    pipe.InitBuffer(b16, TILE * sizeof(half));
    AscendC::LocalTensor<float> l32 = b32.Get<float>();
    AscendC::LocalTensor<half> l16 = b16.Get<half>();

    uint32_t bid = AscendC::GetBlockIdx();
    uint32_t bnum = AscendC::GetBlockNum();
    uint32_t n_units = n / 16;
    uint32_t u0 = (n_units * bid) / bnum;
    uint32_t u1 = (n_units * (bid + 1)) / bnum;
    uint32_t start = u0 * 16;
    uint32_t total = (u1 - u0) * 16;

    for (uint32_t off = 0; off < total; off += TILE) {
        uint32_t cur = (total - off < TILE) ? (total - off) : TILE;
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopy(l32, gs[start + off], cur);
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::Cast(l16, l32, AscendC::RoundMode::CAST_NONE, cur);
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopy(gd[start + off], l16, cur);
        AscendC::PipeBarrier<PIPE_ALL>();
    }
}

extern "C" __global__ __aicore__ void asc_f16_to_f32_kern(GM_ADDR src, GM_ADDR dst, uint32_t n) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    AscendC::GlobalTensor<half> gs;  gs.SetGlobalBuffer((__gm__ half*)src, n);
    AscendC::GlobalTensor<float> gd; gd.SetGlobalBuffer((__gm__ float*)dst, n);

    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> b16, b32;
    constexpr uint32_t TILE = 4096;
    pipe.InitBuffer(b16, TILE * sizeof(half));
    pipe.InitBuffer(b32, TILE * sizeof(float));
    AscendC::LocalTensor<half> l16 = b16.Get<half>();
    AscendC::LocalTensor<float> l32 = b32.Get<float>();

    uint32_t bid = AscendC::GetBlockIdx();
    uint32_t bnum = AscendC::GetBlockNum();
    uint32_t n_units = n / 16;
    uint32_t u0 = (n_units * bid) / bnum;
    uint32_t u1 = (n_units * (bid + 1)) / bnum;
    uint32_t start = u0 * 16;
    uint32_t total = (u1 - u0) * 16;

    for (uint32_t off = 0; off < total; off += TILE) {
        uint32_t cur = (total - off < TILE) ? (total - off) : TILE;
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopy(l16, gs[start + off], cur);
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::Cast(l32, l16, AscendC::RoundMode::CAST_NONE, cur);
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopy(gd[start + off], l32, cur);
        AscendC::PipeBarrier<PIPE_ALL>();
    }
}

// ============================================================================
// 2. Hyper-Connection (Gated Residual) Norm + Post-Down + Post-Up
// ============================================================================
extern "C" __global__ __aicore__ void asc_gr_norm_kern(
    GM_ADDR R, GM_ADDR bo, GM_ADDR inj, GM_ADDR w_norm,
    GM_ADDR xn_f32, GM_ADDR xn_f16, uint32_t n_tok, uint32_t apply, float eps)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    constexpr uint32_t N = 2560;
    constexpr uint32_t HC = 4;
    uint32_t total_rows = n_tok * HC;
    uint32_t inj_len_aligned = ((total_rows + 7) / 8) * 8;

    AscendC::GlobalTensor<float> gR;    gR.SetGlobalBuffer((__gm__ float*)R, total_rows * N);
    AscendC::GlobalTensor<float> gBo;   gBo.SetGlobalBuffer((__gm__ float*)bo, n_tok * N);
    AscendC::GlobalTensor<half>  gBo16; gBo16.SetGlobalBuffer((__gm__ half*)bo, n_tok * N);
    AscendC::GlobalTensor<float> gInj;  gInj.SetGlobalBuffer((__gm__ float*)inj, inj_len_aligned);
    AscendC::GlobalTensor<float> gWn;   gWn.SetGlobalBuffer((__gm__ float*)w_norm, HC * N);
    AscendC::GlobalTensor<float> gXn32; gXn32.SetGlobalBuffer((__gm__ float*)xn_f32, total_rows * N);
    AscendC::GlobalTensor<half>  gXn16; gXn16.SetGlobalBuffer((__gm__ half*)xn_f16, total_rows * N);

    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bR, bBo, bW, bSq, bBrs, bX16, bInj;
    pipe.InitBuffer(bR,   N * sizeof(float));
    pipe.InitBuffer(bBo,  N * sizeof(float));
    pipe.InitBuffer(bW,   N * sizeof(float));
    pipe.InitBuffer(bSq,  N * sizeof(float));
    pipe.InitBuffer(bBrs, 320 * sizeof(float));
    pipe.InitBuffer(bX16, N * sizeof(half));
    pipe.InitBuffer(bInj, 2048 * sizeof(float)); // supports n_tok up to 512

    AscendC::LocalTensor<float> lR   = bR.Get<float>();
    AscendC::LocalTensor<float> lBo  = bBo.Get<float>();
    AscendC::LocalTensor<float> lW   = bW.Get<float>();
    AscendC::LocalTensor<float> lSq  = bSq.Get<float>();
    AscendC::LocalTensor<float> lBrs = bBrs.Get<float>();
    AscendC::LocalTensor<half>  lX16 = bX16.Get<half>();
    AscendC::LocalTensor<float> lInj = bInj.Get<float>();

    if (apply) {
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopy(lInj, gInj, inj_len_aligned);
        AscendC::PipeBarrier<PIPE_ALL>();
    }

    uint32_t bid = AscendC::GetBlockIdx();
    uint32_t bnum = AscendC::GetBlockNum();
    for (uint32_t idx = bid; idx < total_rows; idx += bnum) {
        uint32_t t = idx / HC;
        uint32_t c = idx % HC;
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopy(lR, gR[idx * N], N);
        AscendC::DataCopy(lW, gWn[c * N], N);
        if (apply == 1u) {
            AscendC::DataCopy(lBo, gBo[t * N], N);
        } else if (apply == 2u) {
            AscendC::DataCopy(lX16, gBo16[t * N], N);
        }
        AscendC::PipeBarrier<PIPE_ALL>();

        if (apply) {
            if (apply == 2u) {
                AscendC::Cast(lBo, lX16, AscendC::RoundMode::CAST_NONE, N);
                AscendC::PipeBarrier<PIPE_V>();
            }
            float iv = lInj.GetValue(idx);
            float g = 2.0f / (1.0f + fast_expf(-iv * 0.25f));
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::Axpy(lR, lBo, g, N);
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::DataCopy(gR[idx * N], lR, N);
            AscendC::PipeBarrier<PIPE_ALL>();
        }

        AscendC::Mul(lSq, lR, lR, N);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::BlockReduceSum<float>(lBrs, lSq, N / 64, 64, 1, 1, 8);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::BlockReduceSum<float>(lSq, lBrs, 320 / 64, 64, 1, 1, 8);
        AscendC::PipeBarrier<PIPE_ALL>();
        __ubuf__ const float* pSq = (__ubuf__ const float*)lSq.GetPhyAddr();
        float ss0 = 0.0f, ss1 = 0.0f, ss2 = 0.0f, ss3 = 0.0f;
        for (uint32_t d = 0; d < 40; d += 4) {
            ss0 += pSq[d]; ss1 += pSq[d + 1]; ss2 += pSq[d + 2]; ss3 += pSq[d + 3];
        }
        float tot = (ss0 + ss1) + (ss2 + ss3);
        float rs = fast_rsqrtf(tot * (1.0f / 2560.0f) + eps);
        AscendC::PipeBarrier<PIPE_ALL>();

        AscendC::Muls(lSq, lR, rs, N);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(lSq, lSq, lW, N);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Cast(lX16, lSq, AscendC::RoundMode::CAST_NONE, N);
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopy(gXn32[idx * N], lSq, N);
        AscendC::DataCopy(gXn16[idx * N], lX16, N);
        AscendC::PipeBarrier<PIPE_ALL>();
    }
}

extern "C" __global__ __aicore__ void asc_gr_post_down_kern(
    GM_ADDR down_f16, GM_ADDR lo_f16, GM_ADDR inj_next_f32, uint32_t n_tok)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    // Process in pairs of 2 tokens across all 8 AI Cores: each pair owns 2 * 4 = 8 floats (32B!) of inj_next_f32,
    // so every core writes strictly disjoint 32-byte cachelines with vectorized PIPE_V SiLU!
    constexpr uint32_t W_STRIDE = 336; // 320 + 4 + 12 pad (multiple of 16 halfs = 32B!)
    constexpr uint32_t LR = 320;       // 320 halfs = 640B (5 * 64 floats on PIPE_V, 32B-aligned!)
    constexpr uint32_t HC = 4;
    uint32_t n_pairs = (n_tok + 1) / 2;
    uint32_t inj_aligned = n_pairs * 8;

    AscendC::GlobalTensor<half>  gDn;  gDn.SetGlobalBuffer((__gm__ half*)down_f16, n_tok * W_STRIDE);
    AscendC::GlobalTensor<half>  gLo;  gLo.SetGlobalBuffer((__gm__ half*)lo_f16, n_tok * LR);
    AscendC::GlobalTensor<float> gInj; gInj.SetGlobalBuffer((__gm__ float*)inj_next_f32, inj_aligned);

    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bDn16, bDn32, bTmp, bOnes, bLo16, bInj;
    pipe.InitBuffer(bDn16, W_STRIDE * sizeof(half));
    pipe.InitBuffer(bDn32, W_STRIDE * sizeof(float));
    pipe.InitBuffer(bTmp,  LR * sizeof(float));
    pipe.InitBuffer(bOnes, LR * sizeof(float));
    pipe.InitBuffer(bLo16, LR * sizeof(half));
    pipe.InitBuffer(bInj,  8 * sizeof(float));

    AscendC::LocalTensor<half>  lDn16 = bDn16.Get<half>();
    AscendC::LocalTensor<float> lDn32 = bDn32.Get<float>();
    AscendC::LocalTensor<float> lTmp  = bTmp.Get<float>();
    AscendC::LocalTensor<float> lOnes = bOnes.Get<float>();
    AscendC::LocalTensor<half>  lLo16 = bLo16.Get<half>();
    AscendC::LocalTensor<float> lInj  = bInj.Get<float>();

    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::Duplicate(lOnes, 1.0f, LR);
    AscendC::PipeBarrier<PIPE_ALL>();

    uint32_t bid = AscendC::GetBlockIdx();
    uint32_t bnum = AscendC::GetBlockNum();
    __ubuf__ float* pInj = (__ubuf__ float*)lInj.GetPhyAddr();

    for (uint32_t pair = bid; pair < n_pairs; pair += bnum) {
        uint32_t t0 = pair * 2;
        uint32_t cnt = (n_tok - t0 < 2) ? (n_tok - t0) : 2;
        for (uint32_t i = 0; i < 8; ++i) pInj[i] = 0.0f;

        for (uint32_t sub = 0; sub < cnt; ++sub) {
            uint32_t t = t0 + sub;
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::DataCopy(lDn16, gDn[t * W_STRIDE], W_STRIDE);
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::Cast(lDn32, lDn16, AscendC::RoundMode::CAST_NONE, W_STRIDE);
            AscendC::PipeBarrier<PIPE_ALL>();

            __ubuf__ const float* p32 = (__ubuf__ const float*)lDn32.GetPhyAddr();
            for (uint32_t c = 0; c < HC; ++c) {
                pInj[sub * HC + c] = p32[LR + c];
            }
            AscendC::PipeBarrier<PIPE_ALL>();

            // Vectorized SiLU(dn[0..319] * 0.25f) on PIPE_V
            AscendC::Muls(lDn32, lDn32, 0.25f, LR);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Muls(lTmp, lDn32, -1.0f, LR);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Exp(lTmp, lTmp, LR);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Adds(lTmp, lTmp, 1.0f, LR);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Div(lTmp, lOnes, lTmp, LR);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Mul(lTmp, lDn32, lTmp, LR);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Cast(lLo16, lTmp, AscendC::RoundMode::CAST_NONE, LR);
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::DataCopy(gLo[t * LR], lLo16, LR);
            AscendC::PipeBarrier<PIPE_ALL>();
        }
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopy(gInj[pair * 8], lInj, 8);
        AscendC::PipeBarrier<PIPE_ALL>();
    }
}

extern "C" __global__ __aicore__ void asc_gr_post_up_kern(
    GM_ADDR xn_f32, GM_ADDR gate_f16, GM_ADDR out_f16, GM_ADDR out_f32, uint32_t n_tok)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    constexpr uint32_t N = 2560;
    constexpr uint32_t HC = 4;
    constexpr uint32_t HCD = HC * N; // 10240
    constexpr uint32_t SLICE = 320;  // 2560 / 8 cores = 320 (640B f16, 1280B f32, both 32B-aligned!)

    uint32_t bid = AscendC::GetBlockIdx();
    if (bid >= 8) return;
    uint32_t d0 = bid * SLICE;

    AscendC::GlobalTensor<float> gXn;  gXn.SetGlobalBuffer((__gm__ float*)xn_f32, n_tok * HCD);
    AscendC::GlobalTensor<half>  gGt;  gGt.SetGlobalBuffer((__gm__ half*)gate_f16, n_tok * HCD);
    AscendC::GlobalTensor<half>  gO16; gO16.SetGlobalBuffer((__gm__ half*)out_f16, n_tok * N);
    AscendC::GlobalTensor<float> gO32; gO32.SetGlobalBuffer((__gm__ float*)out_f32, n_tok * N);

    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bXn, bG16, bG32, bOnes, bO32, bO16;
    pipe.InitBuffer(bXn,   SLICE * sizeof(float));
    pipe.InitBuffer(bG16,  SLICE * sizeof(half));
    pipe.InitBuffer(bG32,  SLICE * sizeof(float));
    pipe.InitBuffer(bOnes, SLICE * sizeof(float));
    pipe.InitBuffer(bO32,  SLICE * sizeof(float));
    pipe.InitBuffer(bO16,  SLICE * sizeof(half));

    AscendC::LocalTensor<float> lXn   = bXn.Get<float>();
    AscendC::LocalTensor<half>  lG16  = bG16.Get<half>();
    AscendC::LocalTensor<float> lG32  = bG32.Get<float>();
    AscendC::LocalTensor<float> lOnes = bOnes.Get<float>();
    AscendC::LocalTensor<float> lO32  = bO32.Get<float>();
    AscendC::LocalTensor<half>  lO16  = bO16.Get<half>();

    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::Duplicate(lOnes, 1.0f, SLICE);
    AscendC::PipeBarrier<PIPE_ALL>();

    for (uint32_t t = 0; t < n_tok; ++t) {
        AscendC::Duplicate(lO32, 0.0f, SLICE);
        AscendC::PipeBarrier<PIPE_ALL>();
        for (uint32_t c = 0; c < HC; ++c) {
            uint32_t off = t * HCD + c * N + d0;
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::DataCopy(lXn,  gXn[off], SLICE);
            AscendC::DataCopy(lG16, gGt[off], SLICE);
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::Cast(lG32, lG16, AscendC::RoundMode::CAST_NONE, SLICE);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Muls(lG32, lG32, -1.0f, SLICE);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Exp(lG32, lG32, SLICE);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Adds(lG32, lG32, 1.0f, SLICE);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Div(lG32, lOnes, lG32, SLICE);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Mul(lG32, lXn, lG32, SLICE);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Add(lO32, lO32, lG32, SLICE);
            AscendC::PipeBarrier<PIPE_ALL>();
        }
        AscendC::Muls(lO32, lO32, 0.25f, SLICE);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Cast(lO16, lO32, AscendC::RoundMode::CAST_NONE, SLICE);
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopy(gO32[t * N + d0], lO32, SLICE);
        AscendC::DataCopy(gO16[t * N + d0], lO16, SLICE);
        AscendC::PipeBarrier<PIPE_ALL>();
    }
}

// ============================================================================
// 3. Fused GDN (Gated DeltaNet) Recurrence Step
// ============================================================================
extern "C" __global__ __aicore__ void asc_gdn_step_kern(
    GM_ADDR state_f32, GM_ADDR hist_in_f32, GM_ADDR hist_out_f32,
    GM_ADDR gdn_in_f16, GM_ADDR qkv_save_f32, GM_ADDR z_save_f32, GM_ADDR ab_save_f32,
    GM_ADDR conv_w_f32, GM_ADDR dt_f32, GM_ADDR ssm_a_f32, GM_ADDR gamma_f32,
    GM_ADDR yg_f16, uint32_t n_tok, uint32_t commit_at, uint32_t from_saved, float eps)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    constexpr uint32_t HK = 16;
    constexpr uint32_t HV = 48;
    constexpr uint32_t S = 128;
    constexpr uint32_t CONV = 10240; // (2*16 + 48)*128
    constexpr uint32_t ZV = 6144;    // 48*128
    constexpr uint32_t IN_STRIDE = 16480; // 10240 + 6144 + 48 + 48

    AscendC::GlobalTensor<float> gSt;   gSt.SetGlobalBuffer((__gm__ float*)state_f32, HV * S * S);
    AscendC::GlobalTensor<float> gHi;   gHi.SetGlobalBuffer((__gm__ float*)hist_in_f32, CONV * 4);
    AscendC::GlobalTensor<float> gHo;   gHo.SetGlobalBuffer((__gm__ float*)hist_out_f32, CONV * 4);
    AscendC::GlobalTensor<half>  gIn16; gIn16.SetGlobalBuffer((__gm__ half*)gdn_in_f16, n_tok * IN_STRIDE);
    AscendC::GlobalTensor<float> gQkvS; gQkvS.SetGlobalBuffer((__gm__ float*)qkv_save_f32, n_tok * CONV);
    AscendC::GlobalTensor<float> gZS;   gZS.SetGlobalBuffer((__gm__ float*)z_save_f32, n_tok * ZV);
    AscendC::GlobalTensor<float> gAbS;  gAbS.SetGlobalBuffer((__gm__ float*)ab_save_f32, n_tok * 96);
    AscendC::GlobalTensor<float> gCw;   gCw.SetGlobalBuffer((__gm__ float*)conv_w_f32, CONV * 4);
    AscendC::GlobalTensor<float> gDt;   gDt.SetGlobalBuffer((__gm__ float*)dt_f32, 64);
    AscendC::GlobalTensor<float> gSa;   gSa.SetGlobalBuffer((__gm__ float*)ssm_a_f32, 64);
    AscendC::GlobalTensor<float> gGm;   gGm.SetGlobalBuffer((__gm__ float*)gamma_f32, S);
    AscendC::GlobalTensor<half>  gYg;   gYg.SetGlobalBuffer((__gm__ half*)yg_f16, n_tok * ZV);

    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bS, bCwRaw, bHiRaw, bCwUnp, bHiUnp, bConv, bAcc4, bVec, bOnes, bMeta, bIn16, bOut16;
    pipe.InitBuffer(bS,     S * S * sizeof(float));       // 64 KB
    pipe.InitBuffer(bCwRaw, 3 * S * 4 * sizeof(float));   // 6 KB: [cwQ | cwK | cwV]
    pipe.InitBuffer(bHiRaw, 3 * S * 4 * sizeof(float));   // 6 KB: [hiQ | hiK | hiV]
    pipe.InitBuffer(bCwUnp, 4 * 384 * sizeof(float));     // 6 KB: cw0..cw3 [384]
    pipe.InitBuffer(bHiUnp, 3 * 384 * sizeof(float));     // 4.5 KB: hi0..hi2 [384]
    pipe.InitBuffer(bConv,  4 * 384 * sizeof(float));     // 6 KB: [qkv_in | conv_out | tmp0 | tmp1]
    pipe.InitBuffer(bAcc4,  4 * S * sizeof(float));       // 2 KB: 4-way ILP accumulators
    pipe.InitBuffer(bVec,   6 * S * sizeof(float));       // 3 KB: [kv | delta | o | z_cur | y_f32 | brs]
    pipe.InitBuffer(bOnes,  384 * sizeof(float));         // 1.5 KB: constant 1.0f
    pipe.InitBuffer(bMeta,  (64 + 64 + S + 96) * sizeof(float)); // 1.5 KB
    pipe.InitBuffer(bIn16,  512 * sizeof(half));          // 1 KB
    pipe.InitBuffer(bOut16, S * sizeof(half));            // 256 B

    AscendC::LocalTensor<float> lS     = bS.Get<float>();
    AscendC::LocalTensor<float> lCwRaw = bCwRaw.Get<float>();
    AscendC::LocalTensor<float> lHiRaw = bHiRaw.Get<float>();
    AscendC::LocalTensor<float> lCwUnp = bCwUnp.Get<float>();
    AscendC::LocalTensor<float> lHiUnp = bHiUnp.Get<float>();
    AscendC::LocalTensor<float> lConv  = bConv.Get<float>();
    AscendC::LocalTensor<float> lAcc4  = bAcc4.Get<float>();
    AscendC::LocalTensor<float> lVec   = bVec.Get<float>();
    AscendC::LocalTensor<float> lOnes  = bOnes.Get<float>();
    AscendC::LocalTensor<float> lMeta  = bMeta.Get<float>();
    AscendC::LocalTensor<half>  lIn16  = bIn16.Get<half>();
    AscendC::LocalTensor<half>  lO16   = bOut16.Get<half>();

    // Load shared small parameters (dt, ssm_a, gamma) + constant ones
    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::DataCopy(lMeta[0],   gDt, 64);
    AscendC::DataCopy(lMeta[64],  gSa, 64);
    AscendC::DataCopy(lMeta[128], gGm, S);
    AscendC::Duplicate(lOnes, 1.0f, 384);
    AscendC::PipeBarrier<PIPE_ALL>();

    const float scale = 0.08838834764831845f; // 1 / sqrt(128)

    uint32_t bid = AscendC::GetBlockIdx();
    uint32_t bnum = AscendC::GetBlockNum();

    for (uint32_t h = bid; h < HV; h += bnum) {
        uint32_t hk = h % HK;
        uint32_t ch_q = hk * S;
        uint32_t ch_k = HK * S + hk * S;
        uint32_t ch_v = 2 * HK * S + h * S;

        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopy(lS,            gSt[h * S * S], S * S);
        AscendC::DataCopy(lCwRaw[0],     gCw[ch_q * 4],  S * 4);
        AscendC::DataCopy(lCwRaw[S * 4], gCw[ch_k * 4],  S * 4);
        AscendC::DataCopy(lCwRaw[S * 8], gCw[ch_v * 4],  S * 4);
        AscendC::DataCopy(lHiRaw[0],     gHi[ch_q * 4],  S * 4);
        AscendC::DataCopy(lHiRaw[S * 4], gHi[ch_k * 4],  S * 4);
        AscendC::DataCopy(lHiRaw[S * 8], gHi[ch_v * 4],  S * 4);
        AscendC::PipeBarrier<PIPE_ALL>();

        // Unpack [384, 4] -> planar cw0..cw3 [384] and hi0..hi2 [384] once per head
        {
            __ubuf__ const float* pCwR = (__ubuf__ const float*)lCwRaw.GetPhyAddr();
            __ubuf__ const float* pHiR = (__ubuf__ const float*)lHiRaw.GetPhyAddr();
            __ubuf__ float* pCwU = (__ubuf__ float*)lCwUnp.GetPhyAddr();
            __ubuf__ float* pHiU = (__ubuf__ float*)lHiUnp.GetPhyAddr();
            for (uint32_t c = 0; c < 384; ++c) {
                pCwU[0 * 384 + c] = pCwR[c * 4 + 0];
                pCwU[1 * 384 + c] = pCwR[c * 4 + 1];
                pCwU[2 * 384 + c] = pCwR[c * 4 + 2];
                pCwU[3 * 384 + c] = pCwR[c * 4 + 3];
                pHiU[0 * 384 + c] = pHiR[c * 4 + 0];
                pHiU[1 * 384 + c] = pHiR[c * 4 + 1];
                pHiU[2 * 384 + c] = pHiR[c * 4 + 2];
            }
        }
        AscendC::PipeBarrier<PIPE_ALL>();

        float dt_h = lMeta.GetValue(h);
        float sa_h = lMeta.GetValue(64 + h);

        AscendC::LocalTensor<float> lQkvIn   = lConv[0 * 384];
        AscendC::LocalTensor<float> lConvOut = lConv[1 * 384];
        AscendC::LocalTensor<float> lTmp0    = lConv[2 * 384];
        AscendC::LocalTensor<float> lTmp1    = lConv[3 * 384];
        AscendC::LocalTensor<float> lQs      = lConvOut[0 * S];
        AscendC::LocalTensor<float> lKs      = lConvOut[1 * S];
        AscendC::LocalTensor<float> lVs      = lConvOut[2 * S];

        AscendC::LocalTensor<float> lKv    = lVec[0 * S];
        AscendC::LocalTensor<float> lDelta = lVec[1 * S];
        AscendC::LocalTensor<float> lO     = lVec[2 * S];
        AscendC::LocalTensor<float> lZ     = lVec[3 * S];
        AscendC::LocalTensor<float> lY     = lVec[4 * S];
        AscendC::LocalTensor<float> lBrs   = lVec[5 * S];

        for (uint32_t t = 0; t < n_tok; ++t) {
            float alpha_val = 0.0f, beta_val = 0.0f;
            AscendC::PipeBarrier<PIPE_ALL>();
            if (!from_saved) {
                uint32_t base = t * IN_STRIDE;
                AscendC::DataCopy(lIn16[0],   gIn16[base + ch_q], S);
                AscendC::DataCopy(lIn16[128], gIn16[base + ch_k], S);
                AscendC::DataCopy(lIn16[256], gIn16[base + ch_v], S);
                AscendC::DataCopy(lIn16[384], gIn16[base + CONV + h * S], S);
                AscendC::PipeBarrier<PIPE_ALL>();
                AscendC::Cast(lQkvIn, lIn16[0],   AscendC::RoundMode::CAST_NONE, 384);
                AscendC::Cast(lZ,     lIn16[384], AscendC::RoundMode::CAST_NONE, S);
                AscendC::PipeBarrier<PIPE_ALL>();

                if (qkv_save_f32 != nullptr && commit_at == 0) {
                    if (h < HK) {
                        AscendC::DataCopy(gQkvS[t * CONV + ch_q], lQkvIn[0 * S], S);
                        AscendC::DataCopy(gQkvS[t * CONV + ch_k], lQkvIn[1 * S], S);
                    }
                    AscendC::DataCopy(gQkvS[t * CONV + ch_v], lQkvIn[2 * S], S);
                    AscendC::DataCopy(gZS[t * ZV + h * S], lZ, S);
                    AscendC::PipeBarrier<PIPE_ALL>();
                }
                AscendC::DataCopy(lIn16[0], gIn16[base + CONV + ZV], 96);
                AscendC::PipeBarrier<PIPE_ALL>();
                AscendC::Cast(lMeta[256], lIn16[0], AscendC::RoundMode::CAST_NONE, 96);
                AscendC::PipeBarrier<PIPE_ALL>();
                if (ab_save_f32 != nullptr && commit_at == 0 && h == 0) {
                    AscendC::DataCopy(gAbS[t * 96], lMeta[256], 96);
                    AscendC::PipeBarrier<PIPE_ALL>();
                }
                alpha_val = lMeta.GetValue(256 + h);
                beta_val  = lMeta.GetValue(256 + HV + h);
            } else {
                AscendC::DataCopy(lQkvIn[0 * S], gQkvS[t * CONV + ch_q], S);
                AscendC::DataCopy(lQkvIn[1 * S], gQkvS[t * CONV + ch_k], S);
                AscendC::DataCopy(lQkvIn[2 * S], gQkvS[t * CONV + ch_v], S);
                AscendC::DataCopy(lMeta[256],    gAbS[t * 96], 96);
                AscendC::PipeBarrier<PIPE_ALL>();
                alpha_val = lMeta.GetValue(256 + h);
                beta_val  = lMeta.GetValue(256 + HV + h);
            }

            // Vectorized 4-tap Conv1d + ring shift + SiLU over [q | k | v] (384 floats on PIPE_V)
            AscendC::Mul(lTmp0,    lHiUnp[0 * 384], lCwUnp[0 * 384], 384);
            AscendC::Mul(lTmp1,    lHiUnp[1 * 384], lCwUnp[1 * 384], 384);
            AscendC::Mul(lConvOut, lHiUnp[2 * 384], lCwUnp[2 * 384], 384);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Add(lTmp0, lTmp0, lTmp1, 384);
            AscendC::Mul(lTmp1, lQkvIn, lCwUnp[3 * 384], 384);
            AscendC::Adds(lHiUnp[0 * 384], lHiUnp[1 * 384], 0.0f, 384);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Add(lConvOut, lConvOut, lTmp1, 384);
            AscendC::Adds(lHiUnp[1 * 384], lHiUnp[2 * 384], 0.0f, 384);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Add(lTmp0, lTmp0, lConvOut, 384);
            AscendC::Adds(lHiUnp[2 * 384], lQkvIn, 0.0f, 384);
            AscendC::PipeBarrier<PIPE_V>();

            AscendC::Muls(lTmp1, lTmp0, -1.0f, 384);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Exp(lTmp1, lTmp1, 384);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Adds(lTmp1, lTmp1, 1.0f, 384);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Div(lTmp1, lOnes, lTmp1, 384);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Mul(lConvOut, lTmp0, lTmp1, 384);
            AscendC::PipeBarrier<PIPE_V>();

            // Vectorized L2 norm on q (128) and k (128)
            AscendC::Mul(lTmp0, lConvOut, lConvOut, 2 * S);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::BlockReduceSum<float>(lBrs, lTmp0, (2 * S) / 64, 64, 1, 1, 8);
            AscendC::PipeBarrier<PIPE_ALL>();

            __ubuf__ const float* pBrs = (__ubuf__ const float*)lBrs.GetPhyAddr();
            float q_ss = 0.0f, k_ss = 0.0f;
            for (uint32_t j = 0; j < 16; ++j) {
                q_ss += pBrs[j];
                k_ss += pBrs[16 + j];
            }
            float q_rs = fast_rsqrtf(q_ss * (1.0f / 128.0f) + eps * (1.0f / 128.0f)) * scale;
            float k_rs = fast_rsqrtf(k_ss * (1.0f / 128.0f) + eps * (1.0f / 128.0f)) * scale;
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::Muls(lQs, lQs, q_rs, S);
            AscendC::Muls(lKs, lKs, k_rs, S);

            // Gate & Beta (Kahan log1p(exp(v)) matching gdn.metal L120-124)
            float vv = alpha_val + dt_h;
            float ev = fast_expf(vv);
            float u = 1.0f + ev;
            float sp = vv > 20.0f ? vv : (u == 1.0f ? ev : fast_logf(u) * ev / (u - 1.0f));
            float g = fast_expf(sp * sa_h);
            float be = fast_sigmoid(beta_val);

            // 4-way ILP recurrence: kv[j] = sum_i S[i, j] * ks[i]
            AscendC::Duplicate(lAcc4, 0.0f, 4 * S);
            AscendC::PipeBarrier<PIPE_ALL>();
            __ubuf__ const float* pKs = (__ubuf__ const float*)lKs.GetPhyAddr();
            __ubuf__ const float* pQs = (__ubuf__ const float*)lQs.GetPhyAddr();
            for (uint32_t i = 0; i < S; i += 4) {
                AscendC::Axpy(lAcc4[0 * S], lS[(i + 0) * S], (float)pKs[i + 0], S);
                AscendC::Axpy(lAcc4[1 * S], lS[(i + 1) * S], (float)pKs[i + 1], S);
                AscendC::Axpy(lAcc4[2 * S], lS[(i + 2) * S], (float)pKs[i + 2], S);
                AscendC::Axpy(lAcc4[3 * S], lS[(i + 3) * S], (float)pKs[i + 3], S);
                AscendC::PipeBarrier<PIPE_V>();
            }
            AscendC::Add(lAcc4[0 * S], lAcc4[0 * S], lAcc4[2 * S], 2 * S);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Add(lKv, lAcc4[0 * S], lAcc4[1 * S], S);
            AscendC::PipeBarrier<PIPE_V>();

            // delta[j] = (vs[j] - g * kv[j]) * be
            AscendC::Muls(lDelta, lKv, -g, S);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Add(lDelta, lVs, lDelta, S);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Muls(lDelta, lDelta, be, S);

            // Disjoint 128-row update S[i, j] = g * S[i, j] + ks[i] * delta[j] with zero inner barriers!
            AscendC::Muls(lS, lS, g, S * S);
            AscendC::PipeBarrier<PIPE_V>();
            for (uint32_t i = 0; i < S; ++i) {
                AscendC::Axpy(lS[i * S], lDelta, (float)pKs[i], S);
            }
            AscendC::PipeBarrier<PIPE_V>();

            if (!from_saved) {
                AscendC::Duplicate(lAcc4, 0.0f, 4 * S);
                AscendC::PipeBarrier<PIPE_V>();
                for (uint32_t i = 0; i < S; i += 4) {
                    AscendC::Axpy(lAcc4[0 * S], lS[(i + 0) * S], (float)pQs[i + 0], S);
                    AscendC::Axpy(lAcc4[1 * S], lS[(i + 1) * S], (float)pQs[i + 1], S);
                    AscendC::Axpy(lAcc4[2 * S], lS[(i + 2) * S], (float)pQs[i + 2], S);
                    AscendC::Axpy(lAcc4[3 * S], lS[(i + 3) * S], (float)pQs[i + 3], S);
                    AscendC::PipeBarrier<PIPE_V>();
                }
                AscendC::Add(lAcc4[0 * S], lAcc4[0 * S], lAcc4[2 * S], 2 * S);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Add(lO, lAcc4[0 * S], lAcc4[1 * S], S);
                AscendC::PipeBarrier<PIPE_V>();

                AscendC::Muls(lO, lO, scale, S);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Mul(lTmp0, lO, lO, S);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::BlockReduceSum<float>(lBrs, lTmp0, S / 64, 64, 1, 1, 8);
                AscendC::PipeBarrier<PIPE_ALL>();
                float o_ss = 0.0f;
                for (uint32_t j = 0; j < 16; ++j) o_ss += pBrs[j];
                float o_rs = fast_rsqrtf(o_ss * (1.0f / 128.0f) + eps);
                AscendC::PipeBarrier<PIPE_ALL>();

                AscendC::Muls(lO, lO, o_rs, S);
                AscendC::Muls(lTmp1, lZ, -1.0f, S);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Mul(lO, lO, lMeta[128], S);
                AscendC::Exp(lTmp1, lTmp1, S);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Adds(lTmp1, lTmp1, 1.0f, S);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Div(lTmp1, lOnes, lTmp1, S);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Mul(lY, lO, lTmp1, S);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Cast(lO16, lY, AscendC::RoundMode::CAST_NONE, S);
                AscendC::PipeBarrier<PIPE_ALL>();
                AscendC::DataCopy(gYg[t * ZV + h * S], lO16, S);
                AscendC::PipeBarrier<PIPE_ALL>();
            }

            if (t + 1 == commit_at) {
                AscendC::PipeBarrier<PIPE_ALL>();
                __ubuf__ const float* pHiU = (__ubuf__ const float*)lHiUnp.GetPhyAddr();
                __ubuf__ float* pHiR = (__ubuf__ float*)lHiRaw.GetPhyAddr();
                for (uint32_t c = 0; c < 384; ++c) {
                    pHiR[c * 4 + 0] = pHiU[0 * 384 + c];
                    pHiR[c * 4 + 1] = pHiU[1 * 384 + c];
                    pHiR[c * 4 + 2] = pHiU[2 * 384 + c];
                }
                AscendC::PipeBarrier<PIPE_ALL>();
                AscendC::DataCopy(gSt[h * S * S], lS, S * S);
                if (h < HK) {
                    AscendC::DataCopy(gHo[ch_q * 4], lHiRaw[0],     S * 4);
                    AscendC::DataCopy(gHo[ch_k * 4], lHiRaw[S * 4], S * 4);
                }
                AscendC::DataCopy(gHo[ch_v * 4], lHiRaw[S * 8], S * 4);
                AscendC::PipeBarrier<PIPE_ALL>();
            }
        }
    }
}

// ============================================================================
// 4. QSA (Query-Selected Sparse Attention): Prep, Select, Online Attn+Merge
// ============================================================================
namespace {
__aicore__ inline void apply_norm_rope_scalar(
    __ubuf__ const float* x, __ubuf__ const float* w, __ubuf__ const float* cs_row,
    __ubuf__ float* out, uint32_t dim, float eps, bool do_rope)
{
    float ss = 0.0f;
    for (uint32_t i = 0; i < dim; ++i) ss += x[i] * x[i];
    float rs = fast_rsqrtf(ss / (float)(int32_t)dim + eps);
    for (uint32_t i = 0; i < dim; ++i) out[i] = x[i] * rs * w[i];
    if (do_rope) {
        // NEOX RoPE on first 64 dims: pairs (p, p + 32), p = 0..31
        for (uint32_t p = 0; p < 32; ++p) {
            float c = cs_row[p * 2];
            float s = cs_row[p * 2 + 1];
            float a = out[p];
            float b = out[p + 32];
            out[p]      = a * c - b * s;
            out[p + 32] = a * s + b * c;
        }
    }
}
}  // namespace

extern "C" __global__ __aicore__ void asc_qsa_prep_kern(
    GM_ADDR qsa_in_f16,
    GM_ADDR qn_f32, GM_ADDR kn_f32, GM_ADDR iqn_f32, GM_ADDR ikn_f32,
    GM_ADDR rope_cs_f32,
    GM_ADDR qcur_f32, GM_ADDR qgate_f32, GM_ADDR qidx_f32,
    GM_ADDR kq_i8, GM_ADDR vq_i8, GM_ADDR ksc_f16, GM_ADDR vsc_f16,
    GM_ADDR tail_f32, GM_ADDR dead_f32, GM_ADDR pooled_f32,
    uint32_t pos0, uint32_t pos_base, uint32_t n_tok, float eps)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    constexpr uint32_t QH = 24, QKV = 2, QD = 256, IH = 4, ID = 128;
    constexpr uint32_t IN_STRIDE = 13952; // 12288 + 512 + 512 + 512 + 128

    AscendC::GlobalTensor<half>   gIn16;  gIn16.SetGlobalBuffer((__gm__ half*)qsa_in_f16, n_tok * IN_STRIDE);
    AscendC::GlobalTensor<float>  gQn;    gQn.SetGlobalBuffer((__gm__ float*)qn_f32, QD);
    AscendC::GlobalTensor<float>  gKn;    gKn.SetGlobalBuffer((__gm__ float*)kn_f32, QD);
    AscendC::GlobalTensor<float>  gIqn;   gIqn.SetGlobalBuffer((__gm__ float*)iqn_f32, ID);
    AscendC::GlobalTensor<float>  gIkn;   gIkn.SetGlobalBuffer((__gm__ float*)ikn_f32, ID);
    AscendC::GlobalTensor<float>  gCs;    gCs.SetGlobalBuffer((__gm__ float*)rope_cs_f32, (pos_base + pos0 + n_tok + 16) * 64);
    AscendC::GlobalTensor<float>  gQcur;  gQcur.SetGlobalBuffer((__gm__ float*)qcur_f32, n_tok * QH * QD);
    AscendC::GlobalTensor<float>  gQgate; gQgate.SetGlobalBuffer((__gm__ float*)qgate_f32, n_tok * QH * QD);
    AscendC::GlobalTensor<float>  gQidx;  gQidx.SetGlobalBuffer((__gm__ float*)qidx_f32, n_tok * IH * ID);
    AscendC::GlobalTensor<int8_t> gKq;    gKq.SetGlobalBuffer((__gm__ int8_t*)kq_i8, (pos0 + n_tok + 16) * QKV * QD);
    AscendC::GlobalTensor<int8_t> gVq;    gVq.SetGlobalBuffer((__gm__ int8_t*)vq_i8, (pos0 + n_tok + 16) * QKV * QD);
    AscendC::GlobalTensor<half>   gKsc;   gKsc.SetGlobalBuffer((__gm__ half*)ksc_f16, (pos0 + n_tok + 16) * 16);
    AscendC::GlobalTensor<half>   gVsc;   gVsc.SetGlobalBuffer((__gm__ half*)vsc_f16, (pos0 + n_tok + 16) * 16);
    AscendC::GlobalTensor<float>  gTail;  gTail.SetGlobalBuffer((__gm__ float*)tail_f32, 4 * ID);
    AscendC::GlobalTensor<float>  gDead;  gDead.SetGlobalBuffer((__gm__ float*)dead_f32, ID);
    AscendC::GlobalTensor<float>  gPool;  gPool.SetGlobalBuffer((__gm__ float*)pooled_f32, ((pos0 + n_tok) / 4 + 8) * ID);

    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bIn16, bIn32, bNorm, bCs, bOutQ, bOutG, bOutI, bKvI8, bSc16, bTail;
    pipe.InitBuffer(bIn16, IN_STRIDE * sizeof(half));   // 28 KB
    pipe.InitBuffer(bIn32, IN_STRIDE * sizeof(float));  // 56 KB
    pipe.InitBuffer(bNorm, (2 * QD + 2 * ID) * sizeof(float)); // 3 KB
    pipe.InitBuffer(bCs,   128 * sizeof(float));        // 512 B
    pipe.InitBuffer(bOutQ, QH * QD * sizeof(float));    // 24 KB
    pipe.InitBuffer(bOutG, QH * QD * sizeof(float));    // 24 KB
    pipe.InitBuffer(bOutI, IH * ID * sizeof(float));    // 2 KB
    pipe.InitBuffer(bKvI8, 2 * QKV * QD * sizeof(int8_t)); // 1 KB
    pipe.InitBuffer(bSc16, 32 * sizeof(half));          // 64 B
    pipe.InitBuffer(bTail, 5 * ID * sizeof(float));     // 2.5 KB

    AscendC::LocalTensor<half>   lIn16 = bIn16.Get<half>();
    AscendC::LocalTensor<float>  lIn32 = bIn32.Get<float>();
    AscendC::LocalTensor<float>  lNorm = bNorm.Get<float>();
    AscendC::LocalTensor<float>  lCs   = bCs.Get<float>();
    AscendC::LocalTensor<float>  lOutQ = bOutQ.Get<float>();
    AscendC::LocalTensor<float>  lOutG = bOutG.Get<float>();
    AscendC::LocalTensor<float>  lOutI = bOutI.Get<float>();
    AscendC::LocalTensor<int8_t> lKvI8 = bKvI8.Get<int8_t>();
    AscendC::LocalTensor<half>   lSc16 = bSc16.Get<half>();
    AscendC::LocalTensor<float>  lTail = bTail.Get<float>();

    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::DataCopy(lNorm[0],             gQn,  QD);
    AscendC::DataCopy(lNorm[QD],            gKn,  QD);
    AscendC::DataCopy(lNorm[2 * QD],        gIqn, ID);
    AscendC::DataCopy(lNorm[2 * QD + ID],   gIkn, ID);
    AscendC::PipeBarrier<PIPE_ALL>();

    __ubuf__ const float* pQn  = (__ubuf__ const float*)lNorm[0].GetPhyAddr();
    __ubuf__ const float* pKn  = (__ubuf__ const float*)lNorm[QD].GetPhyAddr();
    __ubuf__ const float* pIqn = (__ubuf__ const float*)lNorm[2 * QD].GetPhyAddr();
    __ubuf__ const float* pIkn = (__ubuf__ const float*)lNorm[2 * QD + ID].GetPhyAddr();

    uint32_t bid = AscendC::GetBlockIdx();
    uint32_t bnum = AscendC::GetBlockNum();

    // Part A: per-token qcur, qgate, qidx, kq/vq int8 + scales distributed across AI Cores
    for (uint32_t t = bid; t < n_tok; t += bnum) {
        uint32_t cell = pos0 + t;
        uint32_t absp = pos_base + cell;

        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopy(lIn16, gIn16[t * IN_STRIDE], IN_STRIDE);
        AscendC::DataCopy(lCs,   gCs[absp * 64], 64);
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::Cast(lIn32, lIn16, AscendC::RoundMode::CAST_NONE, IN_STRIDE);
        AscendC::PipeBarrier<PIPE_ALL>();

        __ubuf__ const float* pIn  = (__ubuf__ const float*)lIn32.GetPhyAddr();
        __ubuf__ const float* pCs  = (__ubuf__ const float*)lCs.GetPhyAddr();
        __ubuf__ float* pOutQ      = (__ubuf__ float*)lOutQ.GetPhyAddr();
        __ubuf__ float* pOutG      = (__ubuf__ float*)lOutG.GetPhyAddr();
        __ubuf__ float* pOutI      = (__ubuf__ float*)lOutI.GetPhyAddr();
        __ubuf__ int8_t* pKq       = (__ubuf__ int8_t*)lKvI8[0].GetPhyAddr();
        __ubuf__ int8_t* pVq       = (__ubuf__ int8_t*)lKvI8[QKV * QD].GetPhyAddr();
        __ubuf__ uint16_t* pKsc    = (__ubuf__ uint16_t*)lSc16[0].GetPhyAddr();
        __ubuf__ uint16_t* pVsc    = (__ubuf__ uint16_t*)lSc16[16].GetPhyAddr();

        for (uint32_t i = 0; i < 16; ++i) { pKsc[i] = 0; pVsc[i] = 0; }

        // 24 query heads (qfull has [q_256 | gate_256] per head)
        for (uint32_t r = 0; r < QH; ++r) {
            const __ubuf__ float* src_qg = pIn + r * (2 * QD);
            apply_norm_rope_scalar(src_qg, pQn, pCs, pOutQ + r * QD, QD, eps, true);
            for (uint32_t d = 0; d < QD; ++d) pOutG[r * QD + d] = src_qg[QD + d];
        }

        // 2 KV heads: k (norm + rope -> int8 per 64) and v (raw -> int8 per 64)
        __ubuf__ float* tmp_k = (__ubuf__ float*)lTail.GetPhyAddr(); // reuse 256 floats
        const __ubuf__ float* pKcur = pIn + 12288;
        const __ubuf__ float* pVcur = pIn + 12288 + 512;
        for (uint32_t h = 0; h < QKV; ++h) {
            apply_norm_rope_scalar(pKcur + h * QD, pKn, pCs, tmp_k, QD, eps, true);
            for (uint32_t g = 0; g < 4; ++g) {
                float mx_k = 0.0f, mx_v = 0.0f;
                for (uint32_t j = 0; j < 64; ++j) {
                    float ak = tmp_k[g * 64 + j]; if (ak < 0.0f) ak = -ak; if (ak > mx_k) mx_k = ak;
                    float av = pVcur[h * QD + g * 64 + j]; if (av < 0.0f) av = -av; if (av > mx_v) mx_v = av;
                }
                uint16_t shk = float_to_half_scalar(mx_k / 127.0f);
                uint16_t shv = float_to_half_scalar(mx_v / 127.0f);
                float sfk = half_to_float_scalar(shk);
                float sfv = half_to_float_scalar(shv);
                pKsc[h * 4 + g] = shk;
                pVsc[h * 4 + g] = shv;
                for (uint32_t j = 0; j < 64; ++j) {
                    pKq[h * QD + g * 64 + j] = (int8_t)(sfk > 0.0f ? rint_clamp_i8(tmp_k[g * 64 + j] / sfk) : 0);
                    pVq[h * QD + g * 64 + j] = (int8_t)(sfv > 0.0f ? rint_clamp_i8(pVcur[h * QD + g * 64 + j] / sfv) : 0);
                }
            }
        }

        // 4 indexer query heads (128 dims each)
        const __ubuf__ float* pIq = pIn + 12288 + 1024;
        for (uint32_t h = 0; h < IH; ++h) {
            apply_norm_rope_scalar(pIq + h * ID, pIqn, pCs, pOutI + h * ID, ID, eps, true);
        }

        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopy(gQcur[t * QH * QD],  lOutQ, QH * QD);
        AscendC::DataCopy(gQgate[t * QH * QD], lOutG, QH * QD);
        AscendC::DataCopy(gQidx[t * IH * ID],  lOutI, IH * ID);
        AscendC::DataCopy(gKq[cell * QKV * QD], lKvI8[0],        QKV * QD);
        AscendC::DataCopy(gVq[cell * QKV * QD], lKvI8[QKV * QD], QKV * QD);
        AscendC::DataCopy(gKsc[cell * 16],      lSc16[0],        16);
        AscendC::DataCopy(gVsc[cell * 16],      lSc16[16],       16);
        AscendC::PipeBarrier<PIPE_ALL>();
    }

    // Part B: sequential indexer key ring update on core 0 (matches qsa.metal L144-171)
    if (bid == 0) {
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopy(lTail, gTail, 4 * ID);
        AscendC::PipeBarrier<PIPE_ALL>();
        __ubuf__ float* pTail = (__ubuf__ float*)lTail.GetPhyAddr();
        __ubuf__ float* pMean = pTail + 4 * ID;

        for (uint32_t t = 0; t < n_tok; ++t) {
            uint32_t cell = pos0 + t;
            // ikraw is the last 128 halfs of qsa_in_f16[t] (offset 13824, 128 halfs = 256B = 8*32B!)
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::DataCopy(lIn16[0], gIn16[t * IN_STRIDE + 13824], ID);
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::Cast(lIn32[0], lIn16[0], AscendC::RoundMode::CAST_NONE, ID);
            AscendC::PipeBarrier<PIPE_ALL>();

            __ubuf__ const float* pIk = (__ubuf__ const float*)lIn32.GetPhyAddr();
            uint32_t slot = cell & 3u;
            for (uint32_t d = 0; d < ID; ++d) pTail[slot * ID + d] = pIk[d];

            if (cell == 0) {
                apply_norm_rope_scalar(pIk, pIkn, nullptr, pMean, ID, eps, false);
                AscendC::PipeBarrier<PIPE_ALL>();
                AscendC::DataCopy(gDead, lTail[4 * ID], ID);
                AscendC::PipeBarrier<PIPE_ALL>();
            }
            if (slot == 3u) {
                for (uint32_t d = 0; d < ID; ++d) {
                    pMean[d] = (((pTail[d] + pTail[ID + d]) + pTail[2 * ID + d]) + pTail[3 * ID + d]) * 0.25f;
                }
                uint32_t blk = cell >> 2;
                uint32_t blk_pos = pos_base + 4u * blk;
                AscendC::PipeBarrier<PIPE_ALL>();
                AscendC::DataCopy(lCs, gCs[blk_pos * 64], 64);
                AscendC::PipeBarrier<PIPE_ALL>();
                apply_norm_rope_scalar(pMean, pIkn, (__ubuf__ const float*)lCs.GetPhyAddr(), pMean, ID, eps, true);
                AscendC::PipeBarrier<PIPE_ALL>();
                AscendC::DataCopy(gPool[blk * ID], lTail[4 * ID], ID);
                AscendC::PipeBarrier<PIPE_ALL>();
            }
        }
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopy(gTail, lTail, 4 * ID);
        AscendC::PipeBarrier<PIPE_ALL>();
    }
}

extern "C" __global__ __aicore__ void asc_qsa_select_kern(
    GM_ADDR qidx_f32, GM_ADDR pooled_f32, GM_ADDR dead_f32,
    GM_ADDR scores_f32, GM_ADDR qids_i32,
    uint32_t pos0, uint32_t max_blocks_stride, uint32_t n_tok)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    constexpr uint32_t IH = 4, ID = 128;
    constexpr uint32_t QBUDGET = 2051;
    constexpr uint32_t QIDS_STRIDE = 2056; // multiple of 8 ints = 32B!
    constexpr uint32_t BLK_TILE = 16;      // 16 blocks * 128 floats = 8 KB (PIPE_V vectorized!)

    AscendC::GlobalTensor<float>   gQidx; gQidx.SetGlobalBuffer((__gm__ float*)qidx_f32, n_tok * IH * ID);
    AscendC::GlobalTensor<float>   gPool; gPool.SetGlobalBuffer((__gm__ float*)pooled_f32, max_blocks_stride * ID);
    AscendC::GlobalTensor<float>   gDead; gDead.SetGlobalBuffer((__gm__ float*)dead_f32, ID);
    (void)scores_f32;
    AscendC::GlobalTensor<int32_t> gIds;  gIds.SetGlobalBuffer((__gm__ int32_t*)qids_i32, n_tok * QIDS_STRIDE);

    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bQi, bDead, bKeys, bQRep, bProd, bBrs, bSc, bIds, bHist;
    pipe.InitBuffer(bQi,   IH * ID * sizeof(float));                // 2 KB
    pipe.InitBuffer(bDead, ID * sizeof(float));                     // 512 B
    pipe.InitBuffer(bKeys, BLK_TILE * ID * sizeof(float));          // 8 KB
    pipe.InitBuffer(bQRep, IH * BLK_TILE * ID * sizeof(float));     // 32 KB
    pipe.InitBuffer(bProd, BLK_TILE * ID * sizeof(float));          // 8 KB
    pipe.InitBuffer(bBrs,  BLK_TILE * 16 * sizeof(float));          // 1 KB
    pipe.InitBuffer(bSc,   33024 * sizeof(float));                  // 129 KB (supports full 128K context!)
    pipe.InitBuffer(bIds,  QIDS_STRIDE * sizeof(int32_t));          // 8.2 KB
    pipe.InitBuffer(bHist, 256 * sizeof(uint32_t));                 // 1 KB

    AscendC::LocalTensor<float>    lQi   = bQi.Get<float>();
    AscendC::LocalTensor<float>    lDead = bDead.Get<float>();
    AscendC::LocalTensor<float>    lKeys = bKeys.Get<float>();
    AscendC::LocalTensor<float>    lQRep = bQRep.Get<float>();
    AscendC::LocalTensor<float>    lProd = bProd.Get<float>();
    AscendC::LocalTensor<float>    lBrs  = bBrs.Get<float>();
    AscendC::LocalTensor<float>    lSc   = bSc.Get<float>();
    AscendC::LocalTensor<int32_t>  lIds  = bIds.Get<int32_t>();
    AscendC::LocalTensor<uint32_t> lHist = bHist.Get<uint32_t>();

    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::DataCopy(lDead, gDead, ID);
    AscendC::PipeBarrier<PIPE_ALL>();

    uint32_t bid = AscendC::GetBlockIdx();
    uint32_t bnum = AscendC::GetBlockNum();

    for (uint32_t t = bid; t < n_tok; t += bnum) {
        uint32_t n_kv = pos0 + t + 1;
        uint32_t n_bid = n_kv >> 2;
        uint32_t nb = n_bid + 1;

        __ubuf__ int32_t* pIds = (__ubuf__ int32_t*)lIds.GetPhyAddr();
        if (n_kv <= QBUDGET) {
            for (uint32_t c = 0; c < n_kv; ++c) pIds[c] = (int32_t)c;
            for (uint32_t c = n_kv; c < QIDS_STRIDE; ++c) pIds[c] = 0;
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::DataCopy(gIds[t * QIDS_STRIDE], lIds, QIDS_STRIDE);
            AscendC::PipeBarrier<PIPE_ALL>();
            continue;
        }

        // Load 4 indexer query heads and replicate each 16x in UB on PIPE_V
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopy(lQi, gQidx[t * IH * ID], IH * ID);
        AscendC::PipeBarrier<PIPE_ALL>();
        for (uint32_t h = 0; h < IH; ++h) {
            uint32_t base = h * BLK_TILE * ID;
            AscendC::Adds(lQRep[base],          lQi[h * ID], 0.0f, ID);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Adds(lQRep[base + ID],     lQRep[base], 0.0f, ID);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Adds(lQRep[base + 2 * ID], lQRep[base], 0.0f, 2 * ID);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Adds(lQRep[base + 4 * ID], lQRep[base], 0.0f, 4 * ID);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Adds(lQRep[base + 8 * ID], lQRep[base], 0.0f, 8 * ID);
            AscendC::PipeBarrier<PIPE_V>();
        }
        AscendC::PipeBarrier<PIPE_ALL>();

        __ubuf__ const float* pQi   = (__ubuf__ const float*)lQi.GetPhyAddr();
        __ubuf__ const float* pDead = (__ubuf__ const float*)lDead.GetPhyAddr();
        __ubuf__ const float* pBrs  = (__ubuf__ const float*)lBrs.GetPhyAddr();
        __ubuf__ float* pSc         = (__ubuf__ float*)lSc.GetPhyAddr();

        for (uint32_t b0 = 0; b0 < n_bid; b0 += BLK_TILE) {
            uint32_t cur = (n_bid - b0 < BLK_TILE) ? (n_bid - b0) : BLK_TILE;
            for (uint32_t bi = 0; bi < cur; ++bi) pSc[b0 + bi] = 0.0f;

            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::DataCopy(lKeys, gPool[b0 * ID], cur * ID);
            AscendC::PipeBarrier<PIPE_ALL>();

            for (uint32_t h = 0; h < IH; ++h) {
                AscendC::Mul(lProd, lQRep[h * BLK_TILE * ID], lKeys, cur * ID);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::BlockReduceSum<float>(lBrs, lProd, cur * 2, 64, 1, 1, 8);
                AscendC::PipeBarrier<PIPE_ALL>();
                for (uint32_t bi = 0; bi < cur; ++bi) {
                    const __ubuf__ float* pb = pBrs + bi * 16;
                    float d0 = (pb[0] + pb[1]) + (pb[2] + pb[3]);
                    float d1 = (pb[4] + pb[5]) + (pb[6] + pb[7]);
                    float d2 = (pb[8] + pb[9]) + (pb[10] + pb[11]);
                    float d3 = (pb[12] + pb[13]) + (pb[14] + pb[15]);
                    float d = (d0 + d1) + (d2 + d3);
                    if (d > 0.0f) pSc[b0 + bi] += d;
                }
                AscendC::PipeBarrier<PIPE_ALL>();
            }
        }
        // Tail block n_bid
        {
            float s = 0.0f;
            for (uint32_t h = 0; h < IH; ++h) {
                const __ubuf__ float* qptr = pQi + h * ID;
                float d = 0.0f;
                for (uint32_t i = 0; i < ID; ++i) d += qptr[i] * pDead[i];
                if (d > 0.0f) s += d;
            }
            if ((n_kv & 3u) != 0) s += 1e9f;
            pSc[n_bid] = s;
        }

        // Exact 4-pass 8-bit radix select matching qsa.metal L260-327
        __ubuf__ uint32_t* pHist = (__ubuf__ uint32_t*)lHist.GetPhyAddr();
        uint32_t prefix = 0, pmask = 0, need = QBUDGET;
        for (int pass = 0; pass < 4; ++pass) {
            int shift = 24 - 8 * pass;
            for (int v = 0; v < 256; ++v) pHist[v] = 0;
            for (uint32_t b = 0; b < nb; ++b) {
                uint32_t k = float_okey(pSc[b]);
                if ((k & pmask) == prefix) {
                    uint32_t w = (b < n_bid) ? 4u : (n_kv & 3u);
                    pHist[(k >> shift) & 255u] += w;
                }
            }
            uint32_t acc = 0, d = 0;
            for (int v = 255; v >= 0; --v) {
                uint32_t hv = pHist[v];
                if (acc + hv >= need) { d = (uint32_t)v; break; }
                acc += hv;
            }
            prefix |= (d << shift);
            pmask  |= (255u << shift);
            need   -= acc;
        }
        uint32_t thresh = prefix;
        uint32_t out_off = 0, eq_left = need;
        for (uint32_t b = 0; b < nb; ++b) {
            uint32_t k = float_okey(pSc[b]);
            uint32_t cells = (b < n_bid) ? 4u : (n_kv & 3u);
            uint32_t take = 0;
            if (k > thresh) {
                take = cells;
            } else if (k == thresh && eq_left > 0 && cells > 0) {
                take = (cells < eq_left) ? cells : eq_left;
                eq_left -= take;
            }
            for (uint32_t c = 0; c < take; ++c) {
                pIds[out_off++] = (int32_t)(4u * b + c);
            }
        }
        for (uint32_t c = out_off; c < QIDS_STRIDE; ++c) pIds[c] = 0;

        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopy(gIds[t * QIDS_STRIDE], lIds, QIDS_STRIDE);
        AscendC::PipeBarrier<PIPE_ALL>();
    }
}

extern "C" __global__ __aicore__ void asc_qsa_attn_merge_kern(
    GM_ADDR qcur_f32, GM_ADDR qgate_f32,
    GM_ADDR kq_i8, GM_ADDR vq_i8, GM_ADDR ksc_f16, GM_ADDR vsc_f16,
    GM_ADDR qids_i32, GM_ADDR xq_f16,
    uint32_t pos0, uint32_t n_tok)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    constexpr uint32_t QH = 24, QKV = 2, QD = 256;
    constexpr uint32_t QBUDGET = 2051;
    constexpr uint32_t QIDS_STRIDE = 2056;
    constexpr uint32_t H_PER_CORE = 3; // 8 AI Cores * 3 heads = 24 query heads!

    AscendC::GlobalTensor<float>   gQcur;  gQcur.SetGlobalBuffer((__gm__ float*)qcur_f32, n_tok * QH * QD);
    AscendC::GlobalTensor<float>   gQgate; gQgate.SetGlobalBuffer((__gm__ float*)qgate_f32, n_tok * QH * QD);
    AscendC::GlobalTensor<int8_t>  gKq;    gKq.SetGlobalBuffer((__gm__ int8_t*)kq_i8, (pos0 + n_tok + 16) * QKV * QD);
    AscendC::GlobalTensor<int8_t>  gVq;    gVq.SetGlobalBuffer((__gm__ int8_t*)vq_i8, (pos0 + n_tok + 16) * QKV * QD);
    AscendC::GlobalTensor<half>    gKsc;   gKsc.SetGlobalBuffer((__gm__ half*)ksc_f16, (pos0 + n_tok + 16) * 16);
    AscendC::GlobalTensor<half>    gVsc;   gVsc.SetGlobalBuffer((__gm__ half*)vsc_f16, (pos0 + n_tok + 16) * 16);
    AscendC::GlobalTensor<int32_t> gIds;   gIds.SetGlobalBuffer((__gm__ int32_t*)qids_i32, n_tok * QIDS_STRIDE);
    AscendC::GlobalTensor<half>    gXq;    gXq.SetGlobalBuffer((__gm__ half*)xq_f16, n_tok * QH * QD);

    uint32_t bid = AscendC::GetBlockIdx();
    if (bid >= 8) return;
    uint32_t kv_h = bid >> 2;          // 0 for cores 0..3, 1 for cores 4..7
    uint32_t qh0  = bid * H_PER_CORE;  // 0, 3, 6, 9, 12, 15, 18, 21

    constexpr uint32_t CTILE = 16; // Flash-Block 16 KV cells per PIPE_V online-softmax tile!
    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bQ, bG, bAcc, bOnes, bIds, bQRep, bKi8, bVi8, bKh, bVh, bKf, bVf, bProd, bBrs1, bBrs2, bVAcc, bSc, bOut16;
    pipe.InitBuffer(bQ,     H_PER_CORE * QD * sizeof(float));          // 3 KB
    pipe.InitBuffer(bG,     H_PER_CORE * QD * sizeof(float));          // 3 KB
    pipe.InitBuffer(bAcc,   H_PER_CORE * QD * sizeof(float));          // 3 KB
    pipe.InitBuffer(bOnes,  H_PER_CORE * QD * sizeof(float));          // 3 KB
    pipe.InitBuffer(bIds,   QIDS_STRIDE * sizeof(int32_t));            // 8.2 KB
    pipe.InitBuffer(bQRep,  H_PER_CORE * CTILE * QD * sizeof(float));  // 48 KB
    pipe.InitBuffer(bKi8,   CTILE * QD * sizeof(int8_t));              // 4 KB
    pipe.InitBuffer(bVi8,   CTILE * QD * sizeof(int8_t));              // 4 KB
    pipe.InitBuffer(bKh,    CTILE * QD * sizeof(half));                // 8 KB
    pipe.InitBuffer(bVh,    CTILE * QD * sizeof(half));                // 8 KB
    pipe.InitBuffer(bKf,    CTILE * QD * sizeof(float));               // 16 KB
    pipe.InitBuffer(bVf,    CTILE * QD * sizeof(float));               // 16 KB
    pipe.InitBuffer(bProd,  CTILE * QD * sizeof(float));               // 16 KB
    pipe.InitBuffer(bBrs1,  CTILE * 32 * sizeof(float));               // 2 KB
    pipe.InitBuffer(bBrs2,  64 * sizeof(float));                       // 256 B
    pipe.InitBuffer(bVAcc,  4 * QD * sizeof(float));                   // 4 KB
    pipe.InitBuffer(bSc,    CTILE * 32 * sizeof(half));                // 1 KB
    pipe.InitBuffer(bOut16, H_PER_CORE * QD * sizeof(half));           // 1.5 KB (48*32B!)

    AscendC::LocalTensor<float>   lQ     = bQ.Get<float>();
    AscendC::LocalTensor<float>   lG     = bG.Get<float>();
    AscendC::LocalTensor<float>   lAcc   = bAcc.Get<float>();
    AscendC::LocalTensor<float>   lOnes  = bOnes.Get<float>();
    AscendC::LocalTensor<int32_t> lIds   = bIds.Get<int32_t>();
    AscendC::LocalTensor<float>   lQRep  = bQRep.Get<float>();
    AscendC::LocalTensor<int8_t>  lKi8   = bKi8.Get<int8_t>();
    AscendC::LocalTensor<int8_t>  lVi8   = bVi8.Get<int8_t>();
    AscendC::LocalTensor<half>    lKh    = bKh.Get<half>();
    AscendC::LocalTensor<half>    lVh    = bVh.Get<half>();
    AscendC::LocalTensor<float>   lKf    = bKf.Get<float>();
    AscendC::LocalTensor<float>   lVf    = bVf.Get<float>();
    AscendC::LocalTensor<float>   lProd  = bProd.Get<float>();
    AscendC::LocalTensor<float>   lBrs1  = bBrs1.Get<float>();
    AscendC::LocalTensor<float>   lBrs2  = bBrs2.Get<float>();
    AscendC::LocalTensor<float>   lVAcc  = bVAcc.Get<float>();
    AscendC::LocalTensor<half>    lSc    = bSc.Get<half>();
    AscendC::LocalTensor<half>    lOut16 = bOut16.Get<half>();

    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::Duplicate(lOnes, 1.0f, H_PER_CORE * QD);
    AscendC::Duplicate(lBrs1, 0.0f, CTILE * 32);
    AscendC::PipeBarrier<PIPE_ALL>();

    for (uint32_t t = 0; t < n_tok; ++t) {
        uint32_t n_kv = pos0 + t + 1;
        uint32_t width = (n_kv < QBUDGET) ? n_kv : QBUDGET;

        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopy(lQ,   gQcur[(t * QH + qh0) * QD],  H_PER_CORE * QD);
        AscendC::DataCopy(lG,   gQgate[(t * QH + qh0) * QD], H_PER_CORE * QD);
        AscendC::DataCopy(lIds, gIds[t * QIDS_STRIDE],       QIDS_STRIDE);
        AscendC::Duplicate(lAcc, 0.0f, H_PER_CORE * QD);
        AscendC::PipeBarrier<PIPE_ALL>();

        // Replicate each query head 16x in UB on PIPE_V (once per token t!)
        for (uint32_t hh = 0; hh < H_PER_CORE; ++hh) {
            uint32_t base = hh * CTILE * QD;
            AscendC::Adds(lQRep[base],          lQ[hh * QD], 0.0f, QD);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Adds(lQRep[base + QD],     lQRep[base], 0.0f, QD);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Adds(lQRep[base + 2 * QD], lQRep[base], 0.0f, 2 * QD);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Adds(lQRep[base + 4 * QD], lQRep[base], 0.0f, 4 * QD);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Adds(lQRep[base + 8 * QD], lQRep[base], 0.0f, 8 * QD);
            AscendC::PipeBarrier<PIPE_V>();
        }
        AscendC::PipeBarrier<PIPE_ALL>();

        __ubuf__ const int32_t* pIds  = (__ubuf__ const int32_t*)lIds.GetPhyAddr();
        __ubuf__ const float*   pBrs2 = (__ubuf__ const float*)lBrs2.GetPhyAddr();

        float m[H_PER_CORE] = {-1e30f, -1e30f, -1e30f};
        float l[H_PER_CORE] = {0.0f, 0.0f, 0.0f};

        for (uint32_t c0 = 0; c0 < width; c0 += CTILE) {
            uint32_t cur = (width - c0 < CTILE) ? (width - c0) : CTILE;

            AscendC::PipeBarrier<PIPE_ALL>();
            for (uint32_t ci = 0; ci < cur; ++ci) {
                uint32_t cell = (uint32_t)pIds[c0 + ci];
                uint32_t rowi = cell * QKV + kv_h;
                AscendC::DataCopy(lKi8[ci * QD],     gKq[rowi * QD],  QD);
                AscendC::DataCopy(lVi8[ci * QD],     gVq[rowi * QD],  QD);
                AscendC::DataCopy(lSc[ci * 32],      gKsc[cell * 16], 16);
                AscendC::DataCopy(lSc[ci * 32 + 16], gVsc[cell * 16], 16);
            }
            AscendC::PipeBarrier<PIPE_ALL>();

            // Batched Hardware Vector int8 -> half -> float dequant over all `cur` cells at once
            AscendC::Cast(lKh, lKi8, AscendC::RoundMode::CAST_NONE, cur * QD);
            AscendC::Cast(lVh, lVi8, AscendC::RoundMode::CAST_NONE, cur * QD);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Cast(lKf, lKh, AscendC::RoundMode::CAST_NONE, cur * QD);
            AscendC::Cast(lVf, lVh, AscendC::RoundMode::CAST_NONE, cur * QD);
            AscendC::PipeBarrier<PIPE_ALL>();

            __ubuf__ const uint16_t* pSc = (__ubuf__ const uint16_t*)lSc.GetPhyAddr();
            for (uint32_t ci = 0; ci < cur; ++ci) {
                for (uint32_t g = 0; g < 4; ++g) {
                    float ks = half_to_float_scalar(pSc[ci * 32 + kv_h * 4 + g]);
                    float vs = half_to_float_scalar(pSc[ci * 32 + 16 + kv_h * 4 + g]);
                    AscendC::Muls(lKf[ci * QD + g * 64], lKf[ci * QD + g * 64], ks, 64);
                    AscendC::Muls(lVf[ci * QD + g * 64], lVf[ci * QD + g * 64], vs, 64);
                }
            }
            AscendC::PipeBarrier<PIPE_V>();

            // Flash-Block Vectorized Dot Product + 16-Cell Block Online Softmax per query head!
            for (uint32_t hh = 0; hh < H_PER_CORE; ++hh) {
                AscendC::Mul(lProd, lQRep[hh * CTILE * QD], lKf, cur * QD);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::BlockReduceSum<float>(lBrs1, lProd, cur * 4, 64, 1, 1, 8);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::BlockReduceSum<float>(lBrs2, lBrs1, (cur * 32 + 63) / 64, 64, 1, 1, 8);
                AscendC::PipeBarrier<PIPE_ALL>();

                float s_blk[CTILE];
                float m_new = m[hh];
                for (uint32_t ci = 0; ci < cur; ++ci) {
                    float s = ((pBrs2[ci * 4 + 0] + pBrs2[ci * 4 + 1]) +
                               (pBrs2[ci * 4 + 2] + pBrs2[ci * 4 + 3])) * 0.0625f;
                    s_blk[ci] = s;
                    if (s > m_new) m_new = s;
                }
                float alpha = fast_expf(m[hh] - m_new);
                float p_blk[CTILE];
                float l_blk = 0.0f;
                for (uint32_t ci = 0; ci < cur; ++ci) {
                    float p = fast_expf(s_blk[ci] - m_new);
                    p_blk[ci] = p;
                    l_blk += p;
                }
                m[hh] = m_new;
                l[hh] = l[hh] * alpha + l_blk;

                AscendC::PipeBarrier<PIPE_ALL>();
                AscendC::Muls(lAcc[hh * QD], lAcc[hh * QD], alpha, QD);
                AscendC::Duplicate(lVAcc, 0.0f, 4 * QD);
                AscendC::PipeBarrier<PIPE_V>();
                for (uint32_t ci = 0; ci < cur; ++ci) {
                    AscendC::Axpy(lVAcc[(ci & 3u) * QD], lVf[ci * QD], p_blk[ci], QD);
                    if ((ci & 3u) == 3u || ci + 1 == cur) AscendC::PipeBarrier<PIPE_V>();
                }
                AscendC::Add(lVAcc[0 * QD], lVAcc[0 * QD], lVAcc[2 * QD], 2 * QD);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Add(lVAcc[0 * QD], lVAcc[0 * QD], lVAcc[1 * QD], QD);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Add(lAcc[hh * QD], lAcc[hh * QD], lVAcc[0 * QD], QD);
                AscendC::PipeBarrier<PIPE_V>();
            }
            AscendC::PipeBarrier<PIPE_ALL>();
        }

        // Vectorized normalize by 1/l[hh] and multiply by sigmoid(gate) on PIPE_V
        for (uint32_t hh = 0; hh < H_PER_CORE; ++hh) {
            float inv_l = (l[hh] > 0.0f) ? (1.0f / l[hh]) : 0.0f;
            AscendC::Muls(lAcc[hh * QD], lAcc[hh * QD], inv_l, QD);
        }
        AscendC::Muls(lG, lG, -1.0f, H_PER_CORE * QD);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Exp(lG, lG, H_PER_CORE * QD);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(lG, lG, 1.0f, H_PER_CORE * QD);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Div(lG, lOnes, lG, H_PER_CORE * QD);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(lAcc, lAcc, lG, H_PER_CORE * QD);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Cast(lOut16, lAcc, AscendC::RoundMode::CAST_NONE, H_PER_CORE * QD);
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopy(gXq[(t * QH + qh0) * QD], lOut16, H_PER_CORE * QD);
        AscendC::PipeBarrier<PIPE_ALL>();
    }
}

// ============================================================================
// 5. MoE Router + Shared Expert SwiGLU + Planar Q2_0 Routed Experts + Combine
// ============================================================================
extern "C" __global__ __aicore__ void asc_moe_route_shexp_kern(
    GM_ADDR moe_in_f16,
    GM_ADDR ids_i32, GM_ADDR wts_f32, GM_ADDR plan_i32,
    GM_ADDR sh_h_f16, GM_ADDR sg_f32,
    uint32_t n_tok, uint32_t n_expert)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (AscendC::GetBlockIdx() != 0) return;

    constexpr uint32_t IN_STRIDE = 1808; // [logits 512 | gsh 640 | ush 640 | sg 16]
    constexpr uint32_t NFF = 640;
    constexpr uint32_t TOPK = 10;
    constexpr uint32_t TOPK_PAD = 16;    // 16 * 4B = 64B (32B aligned!)

    uint32_t sg_aligned = ((n_tok + 7) / 8) * 8;

    AscendC::GlobalTensor<half>    gIn16; gIn16.SetGlobalBuffer((__gm__ half*)moe_in_f16, n_tok * IN_STRIDE);
    AscendC::GlobalTensor<int32_t> gIds;  gIds.SetGlobalBuffer((__gm__ int32_t*)ids_i32, n_tok * TOPK_PAD);
    AscendC::GlobalTensor<float>   gWts;  gWts.SetGlobalBuffer((__gm__ float*)wts_f32, n_tok * TOPK_PAD);
    AscendC::GlobalTensor<int32_t> gPlan; gPlan.SetGlobalBuffer((__gm__ int32_t*)plan_i32, P_INTS);
    AscendC::GlobalTensor<half>    gShH;  gShH.SetGlobalBuffer((__gm__ half*)sh_h_f16, n_tok * NFF);
    AscendC::GlobalTensor<float>   gSg;   gSg.SetGlobalBuffer((__gm__ float*)sg_f32, sg_aligned);

    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bIn16, bIn32, bSh16, bIds, bWts, bPlan, bSg, bCnt;
    pipe.InitBuffer(bIn16, IN_STRIDE * sizeof(half));        // 3.6 KB
    pipe.InitBuffer(bIn32, IN_STRIDE * sizeof(float));       // 7.2 KB
    pipe.InitBuffer(bSh16, NFF * sizeof(half));              // 1.3 KB
    pipe.InitBuffer(bIds,  128 * TOPK_PAD * sizeof(int32_t));// 8 KB
    pipe.InitBuffer(bWts,  128 * TOPK_PAD * sizeof(float));  // 8 KB
    pipe.InitBuffer(bPlan, P_INTS * sizeof(int32_t));        // 2.7 KB
    pipe.InitBuffer(bSg,   256 * sizeof(float));             // 1 KB
    pipe.InitBuffer(bCnt,  512 * sizeof(int32_t));           // 2 KB

    AscendC::LocalTensor<half>    lIn16 = bIn16.Get<half>();
    AscendC::LocalTensor<float>   lIn32 = bIn32.Get<float>();
    AscendC::LocalTensor<half>    lSh16 = bSh16.Get<half>();
    AscendC::LocalTensor<int32_t> lIds  = bIds.Get<int32_t>();
    AscendC::LocalTensor<float>   lWts  = bWts.Get<float>();
    AscendC::LocalTensor<int32_t> lPlan = bPlan.Get<int32_t>();
    AscendC::LocalTensor<float>   lSg   = bSg.Get<float>();
    AscendC::LocalTensor<int32_t> lCnt  = bCnt.Get<int32_t>();

    __ubuf__ int32_t* pIds  = (__ubuf__ int32_t*)lIds.GetPhyAddr();
    __ubuf__ float*   pWts  = (__ubuf__ float*)lWts.GetPhyAddr();
    __ubuf__ int32_t* pPlan = (__ubuf__ int32_t*)lPlan.GetPhyAddr();
    __ubuf__ float*   pSg   = (__ubuf__ float*)lSg.GetPhyAddr();
    __ubuf__ int32_t* pCnt  = (__ubuf__ int32_t*)lCnt.GetPhyAddr();

    for (uint32_t i = 0; i < sg_aligned; ++i) pSg[i] = 0.0f;
    for (uint32_t i = 0; i < P_INTS; ++i) pPlan[i] = 0;
    for (uint32_t e = 0; e < n_expert; ++e) pCnt[e] = 0;

    for (uint32_t t = 0; t < n_tok; ++t) {
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopy(lIn16, gIn16[t * IN_STRIDE], IN_STRIDE);
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::Cast(lIn32, lIn16, AscendC::RoundMode::CAST_NONE, IN_STRIDE);
        AscendC::PipeBarrier<PIPE_ALL>();

        __ubuf__ float* pIn = (__ubuf__ float*)lIn32.GetPhyAddr();
        // 1) Shared expert SwiGLU: sh_h = silu(gsh) * ush, plus sg[t]
        __ubuf__ uint16_t* pSh16 = (__ubuf__ uint16_t*)lSh16.GetPhyAddr();
        for (uint32_t d = 0; d < NFF; ++d) {
            float gv = pIn[512 + d];
            float uv = pIn[512 + NFF + d];
            pSh16[d] = float_to_half_scalar(fast_silu(gv) * uv);
        }
        pSg[t] = pIn[512 + 2 * NFF];
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopy(gShH[t * NFF], lSh16, NFF);
        AscendC::PipeBarrier<PIPE_ALL>();

        // 2) Softmax over n_expert logits + top-10 selection (matches moe.metal route_tok L128-165)
        float mx = -1e30f;
        for (uint32_t e = 0; e < n_expert; ++e) {
            if (pIn[e] > mx) mx = pIn[e];
        }
        float sum = 0.0f;
        for (uint32_t e = 0; e < n_expert; ++e) {
            float p = fast_expf(pIn[e] - mx);
            pIn[e] = p;
            sum += p;
        }
        float rcp = 1.0f / sum;
        for (uint32_t e = 0; e < n_expert; ++e) {
            pIn[e] *= rcp;
        }
        float ssum = 0.0f;
        float raw_w[TOPK];
        for (uint32_t r = 0; r < TOPK; ++r) {
            float best = -1e30f;
            uint32_t best_e = 0;
            for (uint32_t e = 0; e < n_expert; ++e) {
                if (pIn[e] > best) { best = pIn[e]; best_e = e; }
            }
            pIn[best_e] = -1e30f;
            pIds[t * TOPK_PAD + r] = (int32_t)best_e;
            raw_w[r] = best;
            ssum += best;
            pCnt[best_e] += 1;
        }
        float denom = (ssum > 6.103515625e-05f) ? ssum : 6.103515625e-05f; // 2^-14
        float inv_d = 1.0f / denom;
        for (uint32_t r = 0; r < TOPK; ++r) {
            pWts[t * TOPK_PAD + r] = raw_w[r] * inv_d;
        }
        for (uint32_t r = TOPK; r < TOPK_PAD; ++r) {
            pIds[t * TOPK_PAD + r] = 0;
            pWts[t * TOPK_PAD + r] = 0.0f;
        }
    }

    // 3) Build deterministic expert grouping plan (for n_tok <= 12 -> <= 120 entries < P_MAXE=128)
    if (n_tok * TOPK <= P_MAXE) {
        int32_t ng = 0, oe = 0;
        for (uint32_t e = 0; e < n_expert; ++e) {
            if (pCnt[e] > 0) {
                int32_t gi = ng++;
                pPlan[P_GEXP + gi] = (int32_t)e;
                pPlan[P_GSTART + gi] = oe;
                int32_t j = 0;
                for (uint32_t t = 0; t < n_tok; ++t) {
                    for (uint32_t r = 0; r < TOPK; ++r) {
                        if (pIds[t * TOPK_PAD + r] == (int32_t)e) {
                            pPlan[P_ETOK + oe + j] = (int32_t)t;
                            union { float f; int32_t i; } u;
                            u.f = pWts[t * TOPK_PAD + r];
                            pPlan[P_EW + oe + j] = u.i;
                            pPlan[P_TOKENT + t * TOPK + r] = oe + j;
                            ++j;
                        }
                    }
                }
                oe += pCnt[e];
            }
        }
        pPlan[P_NG] = ng;
        pPlan[P_GSTART + ng] = oe;
    }

    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::DataCopy(gIds,  lIds,  n_tok * TOPK_PAD);
    AscendC::DataCopy(gWts,  lWts,  n_tok * TOPK_PAD);
    AscendC::DataCopy(gPlan, lPlan, P_INTS);
    AscendC::DataCopy(gSg,   lSg,   sg_aligned);
    AscendC::PipeBarrier<PIPE_ALL>();
}

// Planar Q2_0 Gate + Up + SwiGLU across 8 AI Cores (supports n_tok = 1..8)
extern "C" __global__ __aicore__ void asc_moe_q2_gu_kern(
    GM_ADDR gu_qs, GM_ADDR gu_d,
    GM_ADDR xf_f32, GM_ADDR plan_i32, GM_ADDR h_f32, uint32_t n_tok)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    constexpr uint32_t N = 2560;
    constexpr uint32_t NFF = 640;
    constexpr uint32_t ROW_QS = 640;     // 40 blocks * 16B = 640B (20*32B!)
    constexpr uint32_t ROW_D  = 40;      // 40 halfs per row -> 8 rows = 320 halfs = 640B (20*32B!)
    constexpr uint32_t RTILE  = 8;       // 8 rows * 640 = 5120 elems (80 repeats of 64 floats)
    constexpr uint32_t TILE_ELEMS = RTILE * ROW_QS; // 5120
    constexpr uint32_t HALF_WORDS = TILE_ELEMS / 2; // 2560

    AscendC::GlobalTensor<uint8_t> gQs;   gQs.SetGlobalBuffer((__gm__ uint8_t*)gu_qs, 512ULL * 2 * NFF * ROW_QS);
    AscendC::GlobalTensor<half>    gD;    gD.SetGlobalBuffer((__gm__ half*)gu_d,     512ULL * 2 * NFF * ROW_D);
    AscendC::GlobalTensor<float>   gXf;   gXf.SetGlobalBuffer((__gm__ float*)xf_f32, n_tok * N);
    AscendC::GlobalTensor<int32_t> gPlan; gPlan.SetGlobalBuffer((__gm__ int32_t*)plan_i32, P_INTS);
    AscendC::GlobalTensor<float>   gH;    gH.SetGlobalBuffer((__gm__ float*)h_f32,   P_MAXE * NFF);

    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bPlan, bXfRaw, bXp, bQs, bU16, bMask16, bH16, bF32, bD, bDf32, bXpRep, bAccVec, bBrs8, bAccG, bAccU, bOut;
    pipe.InitBuffer(bPlan,   P_INTS * sizeof(int32_t));         // 2.7 KB
    pipe.InitBuffer(bXfRaw,  N * sizeof(float));                // 10 KB
    pipe.InitBuffer(bXp,     8 * 4 * ROW_QS * sizeof(float));   // 80 KB: [tok 0..7][plane 0..3][640]
    pipe.InitBuffer(bQs,     TILE_ELEMS * sizeof(uint8_t));     // 5 KB
    pipe.InitBuffer(bU16,    HALF_WORDS * sizeof(uint16_t));    // 5 KB
    pipe.InitBuffer(bMask16, 4 * HALF_WORDS * sizeof(uint16_t));// 20 KB
    pipe.InitBuffer(bH16,    TILE_ELEMS * sizeof(half));        // 10 KB
    pipe.InitBuffer(bF32,    TILE_ELEMS * sizeof(float));       // 20 KB
    pipe.InitBuffer(bD,      RTILE * ROW_D * sizeof(half));     // 640 B
    pipe.InitBuffer(bDf32,   RTILE * ROW_D * sizeof(float));    // 1.3 KB
    pipe.InitBuffer(bXpRep,  TILE_ELEMS * sizeof(float));       // 20 KB
    pipe.InitBuffer(bAccVec, TILE_ELEMS * sizeof(float));       // 20 KB
    pipe.InitBuffer(bBrs8,   (TILE_ELEMS / 8) * sizeof(float)); // 2.5 KB (640 floats)
    pipe.InitBuffer(bAccG,   8 * RTILE * sizeof(float));        // 256 B
    pipe.InitBuffer(bAccU,   8 * RTILE * sizeof(float));        // 256 B
    pipe.InitBuffer(bOut,    RTILE * sizeof(float));            // 32 B

    AscendC::LocalTensor<int32_t>  lPlan   = bPlan.Get<int32_t>();
    AscendC::LocalTensor<float>    lXfRaw  = bXfRaw.Get<float>();
    AscendC::LocalTensor<float>    lXp     = bXp.Get<float>();
    AscendC::LocalTensor<uint8_t>  lQs     = bQs.Get<uint8_t>();
    AscendC::LocalTensor<uint16_t> lQs16   = bQs.Get<uint16_t>();
    AscendC::LocalTensor<uint16_t> lU16    = bU16.Get<uint16_t>();
    AscendC::LocalTensor<uint8_t>  lU8     = bU16.Get<uint8_t>();
    AscendC::LocalTensor<uint16_t> lMask16 = bMask16.Get<uint16_t>();
    AscendC::LocalTensor<half>     lH16    = bH16.Get<half>();
    AscendC::LocalTensor<float>    lF32    = bF32.Get<float>();
    AscendC::LocalTensor<half>     lD      = bD.Get<half>();
    AscendC::LocalTensor<float>    lDf32   = bDf32.Get<float>();
    AscendC::LocalTensor<float>    lXpRep  = bXpRep.Get<float>();
    AscendC::LocalTensor<float>    lAccVec = bAccVec.Get<float>();
    AscendC::LocalTensor<float>    lBrs8   = bBrs8.Get<float>();
    AscendC::LocalTensor<float>    lOut    = bOut.Get<float>();

    {
        const uint16_t masks[4] = {0x0303u, 0x0C0Cu, 0x3030u, 0xC0C0u};
        __ubuf__ uint16_t* pm = (__ubuf__ uint16_t*)lMask16.GetPhyAddr();
        for (uint32_t p = 0; p < 4; ++p)
            for (uint32_t i = 0; i < HALF_WORDS; ++i) pm[p * HALF_WORDS + i] = masks[p];
    }

    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::DataCopy(lPlan, gPlan, P_INTS);
    AscendC::PipeBarrier<PIPE_ALL>();

    __ubuf__ const int32_t* pPlan = (__ubuf__ const int32_t*)lPlan.GetPhyAddr();
    int32_t ng = pPlan[P_NG];
    if (ng <= 0) return;

    for (uint32_t t = 0; t < n_tok; ++t) {
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopy(lXfRaw, gXf[t * N], N);
        AscendC::PipeBarrier<PIPE_ALL>();
        __ubuf__ const float* pRaw = (__ubuf__ const float*)lXfRaw.GetPhyAddr();
        __ubuf__ float* pXp = (__ubuf__ float*)lXp[t * 4 * ROW_QS].GetPhyAddr();
        for (uint32_t k = 0; k < ROW_QS; ++k) {
            pXp[0 * ROW_QS + k] = pRaw[4 * k + 0];
            pXp[1 * ROW_QS + k] = pRaw[4 * k + 1] * 0.25f;
            pXp[2 * ROW_QS + k] = pRaw[4 * k + 2] * 0.0625f;
            pXp[3 * ROW_QS + k] = pRaw[4 * k + 3] * 0.015625f;
        }
    }
    AscendC::PipeBarrier<PIPE_ALL>();

    constexpr uint32_t NTILES_PER_EXP = NFF / RTILE; // 80
    uint32_t total_work = (uint32_t)ng * NTILES_PER_EXP;
    uint32_t bid = AscendC::GetBlockIdx();
    uint32_t bnum = AscendC::GetBlockNum();

    __ubuf__ float* pAccG = (__ubuf__ float*)bAccG.Get<float>().GetPhyAddr();
    __ubuf__ float* pAccU = (__ubuf__ float*)bAccU.Get<float>().GetPhyAddr();
    __ubuf__ float* pOut  = (__ubuf__ float*)lOut.GetPhyAddr();
    const float neg_off[4] = {-1.0f, -4.0f, -16.0f, -64.0f};

    for (uint32_t w = bid; w < total_work; w += bnum) {
        uint32_t gi = w / NTILES_PER_EXP;
        uint32_t r0 = (w % NTILES_PER_EXP) * RTILE;
        uint32_t exp_id = (uint32_t)pPlan[P_GEXP + gi];
        int32_t e_start = pPlan[P_GSTART + gi];
        int32_t e_end   = pPlan[P_GSTART + gi + 1];
        int32_t n_ent   = e_end - e_start;

        for (uint32_t mat = 0; mat < 2; ++mat) {
            uint64_t qs_off = ((uint64_t)exp_id * 2 + mat) * NFF * ROW_QS + (uint64_t)r0 * ROW_QS;
            uint64_t d_off  = ((uint64_t)exp_id * 2 + mat) * NFF * ROW_D  + (uint64_t)r0 * ROW_D;

            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::DataCopy(lQs, gQs[qs_off], TILE_ELEMS);
            AscendC::DataCopy(lD,  gD[d_off],   RTILE * ROW_D);
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::Cast(lDf32, lD, AscendC::RoundMode::CAST_NONE, RTILE * ROW_D);
            AscendC::PipeBarrier<PIPE_V>();

            for (int32_t ei = 0; ei < n_ent; ++ei) {
                uint32_t tok = (uint32_t)pPlan[P_ETOK + e_start + ei];
                for (uint32_t p = 0; p < 4; ++p) {
                    // Replicate xp[640] -> lXpRep[8 * 640] via 3 binary-doubling PIPE_V copies
                    AscendC::Adds(lXpRep[0],          lXp[(tok * 4 + p) * ROW_QS], 0.0f, ROW_QS);
                    AscendC::And(lU16, lQs16, lMask16[p * HALF_WORDS], HALF_WORDS);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Adds(lXpRep[ROW_QS],     lXpRep[0], 0.0f, ROW_QS);
                    AscendC::Cast(lH16, lU8, AscendC::RoundMode::CAST_NONE, TILE_ELEMS);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Adds(lXpRep[2 * ROW_QS], lXpRep[0], 0.0f, 2 * ROW_QS);
                    AscendC::Cast(lF32, lH16, AscendC::RoundMode::CAST_NONE, TILE_ELEMS);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Adds(lXpRep[4 * ROW_QS], lXpRep[0], 0.0f, 4 * ROW_QS);
                    AscendC::Adds(lF32, lF32, neg_off[p], TILE_ELEMS);
                    AscendC::PipeBarrier<PIPE_V>();

                    if (p == 0) {
                        AscendC::Mul(lAccVec, lF32, lXpRep, TILE_ELEMS);
                    } else {
                        AscendC::Mul(lF32, lF32, lXpRep, TILE_ELEMS);
                        AscendC::PipeBarrier<PIPE_V>();
                        AscendC::Add(lAccVec, lAccVec, lF32, TILE_ELEMS);
                    }
                    AscendC::PipeBarrier<PIPE_V>();
                }

                // Hardware BlockReduceSum: 5120 floats -> 640 sums of 8 floats (80 repeats)
                AscendC::BlockReduceSum<float>(lBrs8, lAccVec, TILE_ELEMS / 64, 64, 1, 1, 8);
                AscendC::PipeBarrier<PIPE_ALL>();

                __ubuf__ const float* pB8 = (__ubuf__ const float*)lBrs8.GetPhyAddr();
                __ubuf__ const float* pDf = (__ubuf__ const float*)lDf32.GetPhyAddr();
                for (uint32_t r = 0; r < RTILE; ++r) {
                    const __ubuf__ float* pb = pB8 + r * (2 * ROW_D);
                    const __ubuf__ float* pd = pDf + r * ROW_D;
                    float s0 = 0.0f, s1 = 0.0f, s2 = 0.0f, s3 = 0.0f;
                    for (uint32_t b = 0; b < ROW_D; b += 4) {
                        s0 += (pb[2 * b + 0] + pb[2 * b + 1]) * pd[b + 0];
                        s1 += (pb[2 * b + 2] + pb[2 * b + 3]) * pd[b + 1];
                        s2 += (pb[2 * b + 4] + pb[2 * b + 5]) * pd[b + 2];
                        s3 += (pb[2 * b + 6] + pb[2 * b + 7]) * pd[b + 3];
                    }
                    float row_acc = (s0 + s1) + (s2 + s3);
                    if (mat == 0) pAccG[ei * RTILE + r] = row_acc;
                    else          pAccU[ei * RTILE + r] = row_acc;
                }
            }
        }

        for (int32_t ei = 0; ei < n_ent; ++ei) {
            uint32_t entry_idx = (uint32_t)(e_start + ei);
            for (uint32_t r = 0; r < RTILE; ++r) {
                pOut[r] = fast_silu(pAccG[ei * RTILE + r]) * pAccU[ei * RTILE + r];
            }
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::DataCopy(gH[entry_idx * NFF + r0], lOut, RTILE);
            AscendC::PipeBarrier<PIPE_ALL>();
        }
    }
}

// Planar Q2_0 Down projection across 8 AI Cores
extern "C" __global__ __aicore__ void asc_moe_q2_down_kern(
    GM_ADDR down_qs, GM_ADDR down_d,
    GM_ADDR h_f32, GM_ADDR plan_i32, GM_ADDR ye_f32)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    constexpr uint32_t N = 2560;
    constexpr uint32_t NFF = 640;
    constexpr uint32_t ROW_QS = 160;   // 10 blocks * 16B = 160B (5*32B!)
    constexpr uint32_t ROW_D  = 10;    // 10 halfs per row -> 32 rows = 320 halfs = 640B (20*32B!)
    constexpr uint32_t RTILE  = 32;    // 32 rows per tile -> 80 tiles per expert (5120 elems!)
    constexpr uint32_t TILE_ELEMS = RTILE * ROW_QS; // 5120
    constexpr uint32_t HALF_WORDS = TILE_ELEMS / 2; // 2560

    AscendC::GlobalTensor<uint8_t> gQs;   gQs.SetGlobalBuffer((__gm__ uint8_t*)down_qs, 512ULL * N * ROW_QS);
    AscendC::GlobalTensor<half>    gD;    gD.SetGlobalBuffer((__gm__ half*)down_d,     512ULL * N * ROW_D);
    AscendC::GlobalTensor<float>   gH;    gH.SetGlobalBuffer((__gm__ float*)h_f32,     P_MAXE * NFF);
    AscendC::GlobalTensor<int32_t> gPlan; gPlan.SetGlobalBuffer((__gm__ int32_t*)plan_i32, P_INTS);
    AscendC::GlobalTensor<float>   gYe;   gYe.SetGlobalBuffer((__gm__ float*)ye_f32,   P_MAXE * N);

    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bPlan, bHRaw, bHp, bQs, bU16, bMask16, bH16, bF32, bD, bDf32, bHpRep, bAccVec, bBrs8, bAcc, bOut;
    pipe.InitBuffer(bPlan,   P_INTS * sizeof(int32_t));          // 2.7 KB
    pipe.InitBuffer(bHRaw,   NFF * sizeof(float));               // 2.5 KB
    pipe.InitBuffer(bHp,     8 * 4 * ROW_QS * sizeof(float));    // 20 KB
    pipe.InitBuffer(bQs,     TILE_ELEMS * sizeof(uint8_t));      // 5 KB
    pipe.InitBuffer(bU16,    HALF_WORDS * sizeof(uint16_t));     // 5 KB
    pipe.InitBuffer(bMask16, 4 * HALF_WORDS * sizeof(uint16_t)); // 20 KB
    pipe.InitBuffer(bH16,    TILE_ELEMS * sizeof(half));         // 10 KB
    pipe.InitBuffer(bF32,    TILE_ELEMS * sizeof(float));        // 20 KB
    pipe.InitBuffer(bD,      RTILE * ROW_D * sizeof(half));      // 640 B
    pipe.InitBuffer(bDf32,   RTILE * ROW_D * sizeof(float));     // 1.3 KB
    pipe.InitBuffer(bHpRep,  TILE_ELEMS * sizeof(float));        // 20 KB
    pipe.InitBuffer(bAccVec, TILE_ELEMS * sizeof(float));        // 20 KB
    pipe.InitBuffer(bBrs8,   (TILE_ELEMS / 8) * sizeof(float));  // 2.5 KB
    pipe.InitBuffer(bAcc,    8 * RTILE * sizeof(float));         // 1 KB
    pipe.InitBuffer(bOut,    RTILE * sizeof(float));             // 128 B

    AscendC::LocalTensor<int32_t>  lPlan   = bPlan.Get<int32_t>();
    AscendC::LocalTensor<float>    lHRaw   = bHRaw.Get<float>();
    AscendC::LocalTensor<float>    lHp     = bHp.Get<float>();
    AscendC::LocalTensor<uint8_t>  lQs     = bQs.Get<uint8_t>();
    AscendC::LocalTensor<uint16_t> lQs16   = bQs.Get<uint16_t>();
    AscendC::LocalTensor<uint16_t> lU16    = bU16.Get<uint16_t>();
    AscendC::LocalTensor<uint8_t>  lU8     = bU16.Get<uint8_t>();
    AscendC::LocalTensor<uint16_t> lMask16 = bMask16.Get<uint16_t>();
    AscendC::LocalTensor<half>     lH16    = bH16.Get<half>();
    AscendC::LocalTensor<float>    lF32    = bF32.Get<float>();
    AscendC::LocalTensor<half>     lD      = bD.Get<half>();
    AscendC::LocalTensor<float>    lDf32   = bDf32.Get<float>();
    AscendC::LocalTensor<float>    lHpRep  = bHpRep.Get<float>();
    AscendC::LocalTensor<float>    lAccVec = bAccVec.Get<float>();
    AscendC::LocalTensor<float>    lBrs8   = bBrs8.Get<float>();
    AscendC::LocalTensor<float>    lOut    = bOut.Get<float>();

    {
        const uint16_t masks[4] = {0x0303u, 0x0C0Cu, 0x3030u, 0xC0C0u};
        __ubuf__ uint16_t* pm = (__ubuf__ uint16_t*)lMask16.GetPhyAddr();
        for (uint32_t p = 0; p < 4; ++p)
            for (uint32_t i = 0; i < HALF_WORDS; ++i) pm[p * HALF_WORDS + i] = masks[p];
    }

    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::DataCopy(lPlan, gPlan, P_INTS);
    AscendC::PipeBarrier<PIPE_ALL>();

    __ubuf__ const int32_t* pPlan = (__ubuf__ const int32_t*)lPlan.GetPhyAddr();
    int32_t ng = pPlan[P_NG];
    if (ng <= 0) return;

    constexpr uint32_t NTILES_PER_EXP = N / RTILE; // 80
    uint32_t total_work = (uint32_t)ng * NTILES_PER_EXP;
    uint32_t bid = AscendC::GetBlockIdx();
    uint32_t bnum = AscendC::GetBlockNum();

    __ubuf__ float* pAcc = (__ubuf__ float*)bAcc.Get<float>().GetPhyAddr();
    __ubuf__ float* pOut = (__ubuf__ float*)lOut.GetPhyAddr();
    const float neg_off[4] = {-1.0f, -4.0f, -16.0f, -64.0f};

    int32_t loaded_gi = -1;
    for (uint32_t w = bid; w < total_work; w += bnum) {
        int32_t gi = (int32_t)(w / NTILES_PER_EXP);
        uint32_t r0 = (w % NTILES_PER_EXP) * RTILE;
        uint32_t exp_id = (uint32_t)pPlan[P_GEXP + gi];
        int32_t e_start = pPlan[P_GSTART + gi];
        int32_t e_end   = pPlan[P_GSTART + gi + 1];
        int32_t n_ent   = e_end - e_start;

        if (gi != loaded_gi) {
            for (int32_t ei = 0; ei < n_ent; ++ei) {
                AscendC::PipeBarrier<PIPE_ALL>();
                AscendC::DataCopy(lHRaw, gH[(uint32_t)(e_start + ei) * NFF], NFF);
                AscendC::PipeBarrier<PIPE_ALL>();
                __ubuf__ const float* pRaw = (__ubuf__ const float*)lHRaw.GetPhyAddr();
                __ubuf__ float* pHp = (__ubuf__ float*)lHp[ei * 4 * ROW_QS].GetPhyAddr();
                for (uint32_t k = 0; k < ROW_QS; ++k) {
                    pHp[0 * ROW_QS + k] = pRaw[4 * k + 0];
                    pHp[1 * ROW_QS + k] = pRaw[4 * k + 1] * 0.25f;
                    pHp[2 * ROW_QS + k] = pRaw[4 * k + 2] * 0.0625f;
                    pHp[3 * ROW_QS + k] = pRaw[4 * k + 3] * 0.015625f;
                }
            }
            loaded_gi = gi;
        }

        uint64_t qs_off = (uint64_t)exp_id * N * ROW_QS + (uint64_t)r0 * ROW_QS;
        uint64_t d_off  = (uint64_t)exp_id * N * ROW_D  + (uint64_t)r0 * ROW_D;

        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopy(lQs, gQs[qs_off], TILE_ELEMS);
        AscendC::DataCopy(lD,  gD[d_off],   RTILE * ROW_D);
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::Cast(lDf32, lD, AscendC::RoundMode::CAST_NONE, RTILE * ROW_D);
        AscendC::PipeBarrier<PIPE_V>();

        for (int32_t ei = 0; ei < n_ent; ++ei) {
            for (uint32_t p = 0; p < 4; ++p) {
                // Replicate hp[160] -> lHpRep[32 * 160] via 5 binary-doubling PIPE_V copies
                AscendC::Adds(lHpRep[0],           lHp[(ei * 4 + p) * ROW_QS], 0.0f, ROW_QS);
                AscendC::And(lU16, lQs16, lMask16[p * HALF_WORDS], HALF_WORDS);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Adds(lHpRep[ROW_QS],      lHpRep[0], 0.0f, ROW_QS);
                AscendC::Cast(lH16, lU8, AscendC::RoundMode::CAST_NONE, TILE_ELEMS);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Adds(lHpRep[2 * ROW_QS],  lHpRep[0], 0.0f, 2 * ROW_QS);
                AscendC::Cast(lF32, lH16, AscendC::RoundMode::CAST_NONE, TILE_ELEMS);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Adds(lHpRep[4 * ROW_QS],  lHpRep[0], 0.0f, 4 * ROW_QS);
                AscendC::Adds(lF32, lF32, neg_off[p], TILE_ELEMS);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Adds(lHpRep[8 * ROW_QS],  lHpRep[0], 0.0f, 8 * ROW_QS);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Adds(lHpRep[16 * ROW_QS], lHpRep[0], 0.0f, 16 * ROW_QS);
                AscendC::PipeBarrier<PIPE_V>();

                if (p == 0) {
                    AscendC::Mul(lAccVec, lF32, lHpRep, TILE_ELEMS);
                } else {
                    AscendC::Mul(lF32, lF32, lHpRep, TILE_ELEMS);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Add(lAccVec, lAccVec, lF32, TILE_ELEMS);
                }
                AscendC::PipeBarrier<PIPE_V>();
            }

            AscendC::BlockReduceSum<float>(lBrs8, lAccVec, TILE_ELEMS / 64, 64, 1, 1, 8);
            AscendC::PipeBarrier<PIPE_ALL>();

            __ubuf__ const float* pB8 = (__ubuf__ const float*)lBrs8.GetPhyAddr();
            __ubuf__ const float* pDf = (__ubuf__ const float*)lDf32.GetPhyAddr();
            for (uint32_t r = 0; r < RTILE; ++r) {
                const __ubuf__ float* pb = pB8 + r * (2 * ROW_D);
                const __ubuf__ float* pd = pDf + r * ROW_D;
                float s0 = 0.0f, s1 = 0.0f;
                for (uint32_t b = 0; b < ROW_D; b += 2) {
                    s0 += (pb[2 * b + 0] + pb[2 * b + 1]) * pd[b + 0];
                    s1 += (pb[2 * b + 2] + pb[2 * b + 3]) * pd[b + 1];
                }
                pAcc[ei * RTILE + r] = s0 + s1;
            }
        }

        for (int32_t ei = 0; ei < n_ent; ++ei) {
            uint32_t entry_idx = (uint32_t)(e_start + ei);
            union { int32_t i; float f; } ew;
            ew.i = pPlan[P_EW + entry_idx];
            for (uint32_t r = 0; r < RTILE; ++r) {
                pOut[r] = pAcc[ei * RTILE + r] * ew.f;
            }
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::DataCopy(gYe[entry_idx * N + r0], lOut, RTILE);
            AscendC::PipeBarrier<PIPE_ALL>();
        }
    }
}

extern "C" __global__ __aicore__ void asc_moe_combine_kern(
    GM_ADDR ye_f32, GM_ADDR plan_i32, GM_ADDR ysh_f16, GM_ADDR sg_f32, GM_ADDR bo_f32, uint32_t n_tok)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    constexpr uint32_t N = 2560;
    constexpr uint32_t TOPK = 10;
    uint32_t sg_aligned = ((n_tok + 7) / 8) * 8;

    AscendC::GlobalTensor<float>   gYe;   gYe.SetGlobalBuffer((__gm__ float*)ye_f32, P_MAXE * N);
    AscendC::GlobalTensor<int32_t> gPlan; gPlan.SetGlobalBuffer((__gm__ int32_t*)plan_i32, P_INTS);
    AscendC::GlobalTensor<half>    gYsh;  gYsh.SetGlobalBuffer((__gm__ half*)ysh_f16, n_tok * N);
    AscendC::GlobalTensor<float>   gSg;   gSg.SetGlobalBuffer((__gm__ float*)sg_f32, sg_aligned);
    AscendC::GlobalTensor<float>   gBo;   gBo.SetGlobalBuffer((__gm__ float*)bo_f32, n_tok * N);

    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bPlan, bSg, bYsh16, bAcc, bTmp;
    pipe.InitBuffer(bPlan,  P_INTS * sizeof(int32_t));
    pipe.InitBuffer(bSg,    256 * sizeof(float));
    pipe.InitBuffer(bYsh16, N * sizeof(half));
    pipe.InitBuffer(bAcc,   N * sizeof(float));
    pipe.InitBuffer(bTmp,   N * sizeof(float));

    AscendC::LocalTensor<int32_t> lPlan  = bPlan.Get<int32_t>();
    AscendC::LocalTensor<float>   lSg    = bSg.Get<float>();
    AscendC::LocalTensor<half>    lYsh16 = bYsh16.Get<half>();
    AscendC::LocalTensor<float>   lAcc   = bAcc.Get<float>();
    AscendC::LocalTensor<float>   lTmp   = bTmp.Get<float>();

    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::DataCopy(lPlan, gPlan, P_INTS);
    AscendC::DataCopy(lSg,   gSg,   sg_aligned);
    AscendC::PipeBarrier<PIPE_ALL>();

    __ubuf__ const int32_t* pPlan = (__ubuf__ const int32_t*)lPlan.GetPhyAddr();
    __ubuf__ const float*   pSg   = (__ubuf__ const float*)lSg.GetPhyAddr();

    uint32_t bid = AscendC::GetBlockIdx();
    uint32_t bnum = AscendC::GetBlockNum();
    for (uint32_t t = bid; t < n_tok; t += bnum) {
        float gs = fast_sigmoid(pSg[t]);
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopy(lYsh16, gYsh[t * N], N);
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::Cast(lAcc, lYsh16, AscendC::RoundMode::CAST_NONE, N);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Muls(lAcc, lAcc, gs, N);
        AscendC::PipeBarrier<PIPE_ALL>();

        for (uint32_t j = 0; j < TOPK; ++j) {
            uint32_t ent = (uint32_t)pPlan[P_TOKENT + t * TOPK + j];
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::DataCopy(lTmp, gYe[ent * N], N);
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::Add(lAcc, lAcc, lTmp, N);
            AscendC::PipeBarrier<PIPE_ALL>();
        }
        AscendC::DataCopy(gBo[t * N], lAcc, N);
        AscendC::PipeBarrier<PIPE_ALL>();
    }
}

// ============================================================================
// 5b. High-Throughput INT8 FRACTAL_NZ Cube MoE Kernels (supports n_tok = 1..512)
// ============================================================================
extern "C" __global__ __aicore__ void asc_moe_route_tok_kern(
    GM_ADDR moe_in_f16, GM_ADDR ids_i32, GM_ADDR wts_f32, GM_ADDR sh_h_f16,
    GM_ADDR group_cumsum_i64, GM_ADDR tok_perm_i32,
    uint32_t n_tok, uint32_t n_expert)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    constexpr uint32_t IN_STRIDE = 1808; // [logits 512 | gsh 640 | ush 640 | sg 16]
    constexpr uint32_t NFF = 640;
    constexpr uint32_t TOPK = 10;
    constexpr uint32_t TOPK_PAD = 16;    // 16 * 4B = 64B (32B-aligned per token!)
    constexpr uint32_t EXP_VEC = 512;    // 8 * 64 floats on PIPE_V
    uint32_t exp_aligned = ((n_expert + 3) / 4) * 4;

    AscendC::GlobalTensor<half>    gIn16; gIn16.SetGlobalBuffer((__gm__ half*)moe_in_f16, n_tok * IN_STRIDE);
    AscendC::GlobalTensor<int32_t> gIds;  gIds.SetGlobalBuffer((__gm__ int32_t*)ids_i32, n_tok * TOPK_PAD);
    AscendC::GlobalTensor<float>   gWts;  gWts.SetGlobalBuffer((__gm__ float*)wts_f32, n_tok * TOPK_PAD);
    AscendC::GlobalTensor<half>    gShH;  gShH.SetGlobalBuffer((__gm__ half*)sh_h_f16, n_tok * NFF);
    AscendC::GlobalTensor<int64_t> gCum;  gCum.SetGlobalBuffer((__gm__ int64_t*)group_cumsum_i64, exp_aligned);
    AscendC::GlobalTensor<int32_t> gPerm; gPerm.SetGlobalBuffer((__gm__ int32_t*)tok_perm_i32, n_tok * TOPK_PAD);

    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bIn16, bIn32, bTmp, bOnes, bSh16, bIds, bWts, bCnt, bCum, bPerm;
    pipe.InitBuffer(bIn16, IN_STRIDE * sizeof(half));
    pipe.InitBuffer(bIn32, IN_STRIDE * sizeof(float));
    pipe.InitBuffer(bTmp,  NFF * sizeof(float));
    pipe.InitBuffer(bOnes, NFF * sizeof(float));
    pipe.InitBuffer(bSh16, NFF * sizeof(half));
    pipe.InitBuffer(bIds,  TOPK_PAD * sizeof(int32_t));
    pipe.InitBuffer(bWts,  TOPK_PAD * sizeof(float));
    pipe.InitBuffer(bCnt,  EXP_VEC * sizeof(int32_t));
    pipe.InitBuffer(bCum,  EXP_VEC * sizeof(int64_t));
    pipe.InitBuffer(bPerm, TOPK_PAD * sizeof(int32_t));

    AscendC::LocalTensor<half>    lIn16 = bIn16.Get<half>();
    AscendC::LocalTensor<float>   lIn32 = bIn32.Get<float>();
    AscendC::LocalTensor<float>   lTmp  = bTmp.Get<float>();
    AscendC::LocalTensor<float>   lOnes = bOnes.Get<float>();
    AscendC::LocalTensor<half>    lSh16 = bSh16.Get<half>();
    AscendC::LocalTensor<int32_t> lIds  = bIds.Get<int32_t>();
    AscendC::LocalTensor<float>   lWts  = bWts.Get<float>();
    AscendC::LocalTensor<int32_t> lCnt  = bCnt.Get<int32_t>();
    AscendC::LocalTensor<int64_t> lCum  = bCum.Get<int64_t>();
    AscendC::LocalTensor<int32_t> lPerm = bPerm.Get<int32_t>();

    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::Duplicate(lOnes, 1.0f, NFF);
    AscendC::PipeBarrier<PIPE_ALL>();

    uint32_t bid = AscendC::GetBlockIdx();
    uint32_t bnum = AscendC::GetBlockNum();
    __ubuf__ int32_t* pIds = (__ubuf__ int32_t*)lIds.GetPhyAddr();
    __ubuf__ float*   pWts = (__ubuf__ float*)lWts.GetPhyAddr();

    for (uint32_t t = bid; t < n_tok; t += bnum) {
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopy(lIn16, gIn16[t * IN_STRIDE], IN_STRIDE);
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::Cast(lIn32, lIn16, AscendC::RoundMode::CAST_NONE, IN_STRIDE);
        AscendC::PipeBarrier<PIPE_ALL>();

        float sg_val = lIn32.GetValue(512 + 2 * NFF);

        // 1) Vectorized Shared Expert SwiGLU: sh_h = half(silu(gsh) * ush) on PIPE_V
        AscendC::Muls(lTmp, lIn32[512], -1.0f, NFF);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Exp(lTmp, lTmp, NFF);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(lTmp, lTmp, 1.0f, NFF);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Div(lTmp, lOnes, lTmp, NFF);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(lTmp, lIn32[512], lTmp, NFF);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(lTmp, lTmp, lIn32[512 + NFF], NFF);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Cast(lSh16, lTmp, AscendC::RoundMode::CAST_NONE, NFF);
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopy(gShH[t * NFF], lSh16, NFF);
        AscendC::PipeBarrier<PIPE_ALL>();

        // 2) Vectorized Softmax over n_expert logits + Top-10 selection
        __ubuf__ float* pIn = (__ubuf__ float*)lIn32.GetPhyAddr();
        float mx = -1e30f;
        for (uint32_t e = 0; e < n_expert; ++e) {
            if (pIn[e] > mx) mx = pIn[e];
        }
        for (uint32_t e = n_expert; e < EXP_VEC; ++e) pIn[e] = -1e30f;
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::Adds(lTmp, lIn32[0], -mx, EXP_VEC);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Exp(lIn32[0], lTmp, EXP_VEC);
        AscendC::PipeBarrier<PIPE_ALL>();

        float sum = 0.0f;
        for (uint32_t e = 0; e < n_expert; ++e) sum += pIn[e];
        float rcp = 1.0f / sum;
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::Muls(lIn32[0], lIn32[0], rcp, EXP_VEC);
        AscendC::PipeBarrier<PIPE_ALL>();

        float ssum = 0.0f;
        float raw_w[TOPK];
        for (uint32_t r = 0; r < TOPK; ++r) {
            float best = -1e30f;
            uint32_t best_e = 0;
            for (uint32_t e = 0; e < n_expert; ++e) {
                if (pIn[e] > best) { best = pIn[e]; best_e = e; }
            }
            pIn[best_e] = -1e30f;
            pIds[r] = (int32_t)best_e;
            raw_w[r] = best;
            ssum += best;
        }
        for (uint32_t r = TOPK; r < TOPK_PAD; ++r) pIds[r] = 0;

        float denom = (ssum > 6.103515625e-05f) ? ssum : 6.103515625e-05f;
        float inv_d = 1.0f / denom;
        for (uint32_t r = 0; r < TOPK; ++r) pWts[r] = raw_w[r] * inv_d;
        pWts[TOPK] = sg_val; // slot 10 stores shared-expert gate logit!
        for (uint32_t r = TOPK + 1; r < TOPK_PAD; ++r) pWts[r] = 0.0f;

        if (n_tok == 1u) {
            // Fused single-token group cumsum + perm (eliminates asc_moe_build_groups_kern launch on T=1 decode!)
            __ubuf__ int32_t* pCnt  = (__ubuf__ int32_t*)lCnt.GetPhyAddr();
            __ubuf__ int64_t* pCum  = (__ubuf__ int64_t*)lCum.GetPhyAddr();
            __ubuf__ int32_t* pPerm = (__ubuf__ int32_t*)lPerm.GetPhyAddr();
            for (uint32_t e = 0; e < exp_aligned; ++e) pCnt[e] = 0;
            for (uint32_t r = 0; r < TOPK; ++r) pCnt[(uint32_t)pIds[r]] = 1;
            int32_t run = 0;
            for (uint32_t e = 0; e < n_expert; ++e) {
                int32_t c = pCnt[e];
                pCnt[e] = run;
                run += c;
                pCum[e] = (int64_t)run;
            }
            for (uint32_t e = n_expert; e < exp_aligned; ++e) pCum[e] = (int64_t)run;
            for (uint32_t r = 0; r < TOPK; ++r) pPerm[r] = pCnt[(uint32_t)pIds[r]];
            for (uint32_t r = TOPK; r < TOPK_PAD; ++r) pPerm[r] = 0;
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::DataCopy(gWts,  lWts,  TOPK_PAD);
            AscendC::DataCopy(gCum,  lCum,  exp_aligned);
            AscendC::DataCopy(gPerm, lPerm, TOPK_PAD);
            AscendC::PipeBarrier<PIPE_ALL>();
        } else {
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::DataCopy(gIds[t * TOPK_PAD], lIds, TOPK_PAD);
            AscendC::DataCopy(gWts[t * TOPK_PAD], lWts, TOPK_PAD);
            AscendC::PipeBarrier<PIPE_ALL>();
        }
    }
}

extern "C" __global__ __aicore__ void asc_moe_build_groups_kern(
    GM_ADDR ids_i32, GM_ADDR group_cumsum_i64, GM_ADDR sorted_tok_i32, GM_ADDR tok_perm_i32,
    uint32_t n_tok, uint32_t n_expert)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (AscendC::GetBlockIdx() != 0) return;

    constexpr uint32_t TOPK = 10;
    constexpr uint32_t TOPK_PAD = 16;
    constexpr uint32_t MAX_TOK = 512;
    constexpr uint32_t MAX_EXP = 512;

    uint32_t total_rows = n_tok * TOPK;
    uint32_t rows_aligned = ((total_rows + 7) / 8) * 8;
    uint32_t exp_aligned  = ((n_expert + 3) / 4) * 4; // multiple of 4 int64_t = 32B

    AscendC::GlobalTensor<int32_t> gIds;  gIds.SetGlobalBuffer((__gm__ int32_t*)ids_i32, n_tok * TOPK_PAD);
    AscendC::GlobalTensor<int64_t> gCum;  gCum.SetGlobalBuffer((__gm__ int64_t*)group_cumsum_i64, exp_aligned);
    AscendC::GlobalTensor<int32_t> gSort; gSort.SetGlobalBuffer((__gm__ int32_t*)sorted_tok_i32, rows_aligned);
    AscendC::GlobalTensor<int32_t> gPerm; gPerm.SetGlobalBuffer((__gm__ int32_t*)tok_perm_i32, n_tok * TOPK_PAD);

    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bIds, bCnt, bCur, bCum, bSort, bPerm;
    pipe.InitBuffer(bIds,  MAX_TOK * TOPK_PAD * sizeof(int32_t)); // 32 KB
    pipe.InitBuffer(bCnt,  MAX_EXP * sizeof(int32_t));            // 2 KB
    pipe.InitBuffer(bCur,  MAX_EXP * sizeof(int32_t));            // 2 KB
    pipe.InitBuffer(bCum,  MAX_EXP * sizeof(int64_t));            // 4 KB
    pipe.InitBuffer(bSort, (MAX_TOK * TOPK + 8) * sizeof(int32_t)); // 20 KB
    pipe.InitBuffer(bPerm, MAX_TOK * TOPK_PAD * sizeof(int32_t)); // 32 KB

    AscendC::LocalTensor<int32_t> lIds  = bIds.Get<int32_t>();
    AscendC::LocalTensor<int32_t> lCnt  = bCnt.Get<int32_t>();
    AscendC::LocalTensor<int32_t> lCur  = bCur.Get<int32_t>();
    AscendC::LocalTensor<int64_t> lCum  = bCum.Get<int64_t>();
    AscendC::LocalTensor<int32_t> lSort = bSort.Get<int32_t>();
    AscendC::LocalTensor<int32_t> lPerm = bPerm.Get<int32_t>();

    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::DataCopy(lIds, gIds, n_tok * TOPK_PAD);
    AscendC::PipeBarrier<PIPE_ALL>();

    __ubuf__ const int32_t* pIds = (__ubuf__ const int32_t*)lIds.GetPhyAddr();
    __ubuf__ int32_t* pCnt       = (__ubuf__ int32_t*)lCnt.GetPhyAddr();
    __ubuf__ int32_t* pCur       = (__ubuf__ int32_t*)lCur.GetPhyAddr();
    __ubuf__ int64_t* pCum       = (__ubuf__ int64_t*)lCum.GetPhyAddr();
    __ubuf__ int32_t* pSort      = (__ubuf__ int32_t*)lSort.GetPhyAddr();
    __ubuf__ int32_t* pPerm      = (__ubuf__ int32_t*)lPerm.GetPhyAddr();

    for (uint32_t e = 0; e < exp_aligned; ++e) pCnt[e] = 0;
    for (uint32_t t = 0; t < n_tok; ++t) {
        const __ubuf__ int32_t* row = pIds + t * TOPK_PAD;
        for (uint32_t r = 0; r < TOPK; ++r) {
            pCnt[(uint32_t)row[r]] += 1;
        }
    }

    int32_t run = 0;
    for (uint32_t e = 0; e < n_expert; ++e) {
        pCur[e] = run;
        run += pCnt[e];
        pCum[e] = (int64_t)run;
    }
    for (uint32_t e = n_expert; e < exp_aligned; ++e) pCum[e] = (int64_t)run;

    for (uint32_t t = 0; t < n_tok; ++t) {
        const __ubuf__ int32_t* row = pIds + t * TOPK_PAD;
        __ubuf__ int32_t* prow = pPerm + t * TOPK_PAD;
        for (uint32_t r = 0; r < TOPK; ++r) {
            uint32_t e = (uint32_t)row[r];
            int32_t m = pCur[e]++;
            pSort[m] = (int32_t)t;
            prow[r] = m;
        }
        for (uint32_t r = TOPK; r < TOPK_PAD; ++r) prow[r] = 0;
    }
    for (uint32_t m = total_rows; m < rows_aligned; ++m) pSort[m] = 0;

    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::DataCopy(gCum,  lCum,  exp_aligned);
    AscendC::DataCopy(gSort, lSort, rows_aligned);
    AscendC::DataCopy(gPerm, lPerm, n_tok * TOPK_PAD);
    AscendC::PipeBarrier<PIPE_ALL>();
}

extern "C" __global__ __aicore__ void asc_moe_gather_x_kern(
    GM_ADDR xf_f16, GM_ADDR sorted_tok_i32, GM_ADDR sorted_x_f16, uint32_t n_tok, uint32_t total_rows)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    constexpr uint32_t N = 2560;
    uint32_t rows_aligned = ((total_rows + 7) / 8) * 8;

    AscendC::GlobalTensor<half>    gXf;   gXf.SetGlobalBuffer((__gm__ half*)xf_f16, n_tok * N);
    AscendC::GlobalTensor<int32_t> gSort; gSort.SetGlobalBuffer((__gm__ int32_t*)sorted_tok_i32, rows_aligned);
    AscendC::GlobalTensor<half>    gOut;  gOut.SetGlobalBuffer((__gm__ half*)sorted_x_f16, total_rows * N);

    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bSort, bRow;
    pipe.InitBuffer(bSort, 5128 * sizeof(int32_t)); // 20 KB
    pipe.InitBuffer(bRow,  N * sizeof(half));       // 5 KB

    AscendC::LocalTensor<int32_t> lSort = bSort.Get<int32_t>();
    AscendC::LocalTensor<half>    lRow  = bRow.Get<half>();

    uint32_t bid = AscendC::GetBlockIdx();
    uint32_t bnum = AscendC::GetBlockNum();

    if (n_tok == 1u) {
        // Single-token fast path: read gXf[0] once into UB and replicate across total_rows!
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopy(lRow, gXf[0], N);
        AscendC::PipeBarrier<PIPE_ALL>();
        for (uint32_t m = bid; m < total_rows; m += bnum) {
            AscendC::DataCopy(gOut[m * N], lRow, N);
        }
        AscendC::PipeBarrier<PIPE_ALL>();
        return;
    }

    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::DataCopy(lSort, gSort, rows_aligned);
    AscendC::PipeBarrier<PIPE_ALL>();

    __ubuf__ const int32_t* pSort = (__ubuf__ const int32_t*)lSort.GetPhyAddr();

    for (uint32_t m = bid; m < total_rows; m += bnum) {
        uint32_t tok = (uint32_t)pSort[m];
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopy(lRow, gXf[tok * N], N);
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopy(gOut[m * N], lRow, N);
        AscendC::PipeBarrier<PIPE_ALL>();
    }
}

extern "C" __global__ __aicore__ void asc_moe_swiglu_f16_kern(
    GM_ADDR gu_f16, GM_ADDR h_f16, uint32_t total_rows)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    constexpr uint32_t NFF = 640;
    constexpr uint32_t GU  = 1280; // [gate_640 | up_640]
    constexpr uint32_t RTILE = 8;

    AscendC::GlobalTensor<half> gGu; gGu.SetGlobalBuffer((__gm__ half*)gu_f16, total_rows * GU);
    AscendC::GlobalTensor<half> gH;  gH.SetGlobalBuffer((__gm__ half*)h_f16, total_rows * NFF);

    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bGu16, bGu32, bTmp, bOnes, bH32, bH16;
    pipe.InitBuffer(bGu16, RTILE * GU * sizeof(half));   // 20 KB
    pipe.InitBuffer(bGu32, RTILE * GU * sizeof(float));  // 40 KB
    pipe.InitBuffer(bTmp,  NFF * sizeof(float));         // 2.5 KB
    pipe.InitBuffer(bOnes, NFF * sizeof(float));         // 2.5 KB
    pipe.InitBuffer(bH32,  RTILE * NFF * sizeof(float)); // 20 KB
    pipe.InitBuffer(bH16,  RTILE * NFF * sizeof(half));  // 10 KB

    AscendC::LocalTensor<half>  lGu16 = bGu16.Get<half>();
    AscendC::LocalTensor<float> lGu32 = bGu32.Get<float>();
    AscendC::LocalTensor<float> lTmp  = bTmp.Get<float>();
    AscendC::LocalTensor<float> lOnes = bOnes.Get<float>();
    AscendC::LocalTensor<float> lH32  = bH32.Get<float>();
    AscendC::LocalTensor<half>  lH16  = bH16.Get<half>();

    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::Duplicate(lOnes, 1.0f, NFF);
    AscendC::PipeBarrier<PIPE_ALL>();

    uint32_t n_tiles = (total_rows + RTILE - 1) / RTILE;
    uint32_t bid = AscendC::GetBlockIdx();
    uint32_t bnum = AscendC::GetBlockNum();

    for (uint32_t ti = bid; ti < n_tiles; ti += bnum) {
        uint32_t m0 = ti * RTILE;
        uint32_t cur = (total_rows - m0 < RTILE) ? (total_rows - m0) : RTILE;

        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopy(lGu16, gGu[m0 * GU], cur * GU);
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::Cast(lGu32, lGu16, AscendC::RoundMode::CAST_NONE, cur * GU);
        AscendC::PipeBarrier<PIPE_V>();

        for (uint32_t r = 0; r < cur; ++r) {
            AscendC::Muls(lTmp, lGu32[r * GU], -1.0f, NFF);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Exp(lTmp, lTmp, NFF);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Adds(lTmp, lTmp, 1.0f, NFF);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Div(lTmp, lOnes, lTmp, NFF);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Mul(lTmp, lGu32[r * GU], lTmp, NFF);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Mul(lH32[r * NFF], lTmp, lGu32[r * GU + NFF], NFF);
            AscendC::PipeBarrier<PIPE_V>();
        }
        AscendC::Cast(lH16, lH32, AscendC::RoundMode::CAST_NONE, cur * NFF);
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopy(gH[m0 * NFF], lH16, cur * NFF);
        AscendC::PipeBarrier<PIPE_ALL>();
    }
}

extern "C" __global__ __aicore__ void asc_moe_combine_f16_kern(
    GM_ADDR ye_f16, GM_ADDR tok_perm_i32, GM_ADDR wts_f32, GM_ADDR ysh_f16, GM_ADDR bo_f32,
    uint32_t n_tok, uint32_t total_rows)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    constexpr uint32_t N = 2560;
    constexpr uint32_t TOPK = 10;
    constexpr uint32_t TOPK_PAD = 16;

    AscendC::GlobalTensor<half>    gYe;   gYe.SetGlobalBuffer((__gm__ half*)ye_f16, total_rows * N);
    AscendC::GlobalTensor<int32_t> gPerm; gPerm.SetGlobalBuffer((__gm__ int32_t*)tok_perm_i32, n_tok * TOPK_PAD);
    AscendC::GlobalTensor<float>   gWts;  gWts.SetGlobalBuffer((__gm__ float*)wts_f32, n_tok * TOPK_PAD);
    AscendC::GlobalTensor<half>    gYsh;  gYsh.SetGlobalBuffer((__gm__ half*)ysh_f16, n_tok * N);
    AscendC::GlobalTensor<float>   gBo;   gBo.SetGlobalBuffer((__gm__ float*)bo_f32, n_tok * N);

    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bPerm, bWts, bY16, bAcc, bTmp;
    pipe.InitBuffer(bPerm, TOPK_PAD * sizeof(int32_t));
    pipe.InitBuffer(bWts,  TOPK_PAD * sizeof(float));
    pipe.InitBuffer(bY16,  N * sizeof(half));
    pipe.InitBuffer(bAcc,  N * sizeof(float));
    pipe.InitBuffer(bTmp,  N * sizeof(float));

    AscendC::LocalTensor<int32_t> lPerm = bPerm.Get<int32_t>();
    AscendC::LocalTensor<float>   lWts  = bWts.Get<float>();
    AscendC::LocalTensor<half>    lY16  = bY16.Get<half>();
    AscendC::LocalTensor<float>   lAcc  = bAcc.Get<float>();
    AscendC::LocalTensor<float>   lTmp  = bTmp.Get<float>();

    uint32_t bid = AscendC::GetBlockIdx();
    uint32_t bnum = AscendC::GetBlockNum();

    for (uint32_t t = bid; t < n_tok; t += bnum) {
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopy(lPerm, gPerm[t * TOPK_PAD], TOPK_PAD);
        AscendC::DataCopy(lWts,  gWts[t * TOPK_PAD],  TOPK_PAD);
        AscendC::DataCopy(lY16,  gYsh[t * N],         N);
        AscendC::PipeBarrier<PIPE_ALL>();

        __ubuf__ const int32_t* pPerm = (__ubuf__ const int32_t*)lPerm.GetPhyAddr();
        __ubuf__ const float*   pWts  = (__ubuf__ const float*)lWts.GetPhyAddr();
        float gs = fast_sigmoid(pWts[TOPK]);

        AscendC::Cast(lAcc, lY16, AscendC::RoundMode::CAST_NONE, N);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Muls(lAcc, lAcc, gs, N);
        AscendC::PipeBarrier<PIPE_ALL>();

        for (uint32_t r = 0; r < TOPK; ++r) {
            uint32_t m = (uint32_t)pPerm[r];
            float w = pWts[r];
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::DataCopy(lY16, gYe[m * N], N);
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::Cast(lTmp, lY16, AscendC::RoundMode::CAST_NONE, N);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Axpy(lAcc, lTmp, w, N);
            AscendC::PipeBarrier<PIPE_ALL>();
        }
        AscendC::DataCopy(gBo[t * N], lAcc, N);
        AscendC::PipeBarrier<PIPE_ALL>();
    }
}

// ============================================================================
// 6. Argmax over FP16 vocabulary logits [n_tok, n_vocab]
// ============================================================================
extern "C" __global__ __aicore__ void asc_argmax_part_kern(
    GM_ADDR logits_f16, GM_ADDR part_val_f32, GM_ADDR part_idx_i32, uint32_t n_tok, uint32_t n_vocab)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    // 8 AI Cores split n_vocab (248320 / 8 = 31040, multiple of 16!)
    uint32_t bid = AscendC::GetBlockIdx();
    if (bid >= 8) return;

    uint32_t chunk = (n_vocab / 8 / 16) * 16;
    uint32_t v0 = bid * chunk;
    uint32_t v1 = (bid == 7) ? n_vocab : (v0 + chunk);

    AscendC::GlobalTensor<half>    gLog; gLog.SetGlobalBuffer((__gm__ half*)logits_f16, n_tok * n_vocab);
    AscendC::GlobalTensor<float>   gPv;  gPv.SetGlobalBuffer((__gm__ float*)part_val_f32, n_tok * 64);
    AscendC::GlobalTensor<int32_t> gPi;  gPi.SetGlobalBuffer((__gm__ int32_t*)part_idx_i32, n_tok * 64);

    AscendC::TPipe pipe;
    constexpr uint32_t TILE = 4096;
    AscendC::TBuf<AscendC::TPosition::VECCALC> b16, b32, bPv, bPi;
    pipe.InitBuffer(b16, TILE * sizeof(half));
    pipe.InitBuffer(b32, TILE * sizeof(float));
    pipe.InitBuffer(bPv, 64 * sizeof(float));
    pipe.InitBuffer(bPi, 64 * sizeof(int32_t));

    AscendC::LocalTensor<half>    l16 = b16.Get<half>();
    AscendC::LocalTensor<float>   l32 = b32.Get<float>();

    for (uint32_t t = 0; t < n_tok; ++t) {
        float best_v = -1e30f;
        int32_t best_i = (int32_t)v0;
        for (uint32_t off = v0; off < v1; off += TILE) {
            uint32_t cur = (v1 - off < TILE) ? (v1 - off) : TILE;
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::DataCopy(l16, gLog[t * n_vocab + off], cur);
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::Cast(l32, l16, AscendC::RoundMode::CAST_NONE, cur);
            AscendC::PipeBarrier<PIPE_ALL>();
            __ubuf__ const float* p = (__ubuf__ const float*)l32.GetPhyAddr();
            for (uint32_t i = 0; i < cur; ++i) {
                if (p[i] > best_v) { best_v = p[i]; best_i = (int32_t)(off + i); }
            }
        }
        // Store per-core winner into GM via atomic-free distinct core slot? Wait: 1 float is 4B (< 32B),
        // so write 8-float block on core `bid` at `bid * 8` (stride 8 floats = 32B per core!!)!
        AscendC::LocalTensor<float>   lPv = bPv.Get<float>();
        AscendC::LocalTensor<int32_t> lPi = bPi.Get<int32_t>();
        __ubuf__ float*   ppv = (__ubuf__ float*)lPv.GetPhyAddr();
        __ubuf__ int32_t* ppi = (__ubuf__ int32_t*)lPi.GetPhyAddr();
        for (int k = 0; k < 8; ++k) { ppv[k] = best_v; ppi[k] = best_i; }
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopy(gPv[(t * 8 + bid) * 8], lPv, 8);
        AscendC::DataCopy(gPi[(t * 8 + bid) * 8], lPi, 8);
        AscendC::PipeBarrier<PIPE_ALL>();
    }
}

extern "C" __global__ __aicore__ void asc_argmax_final_kern(
    GM_ADDR part_val_f32, GM_ADDR part_idx_i32, GM_ADDR tok_out_i32, uint32_t n_tok)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (AscendC::GetBlockIdx() != 0) return;

    AscendC::GlobalTensor<float>   gPv;  gPv.SetGlobalBuffer((__gm__ float*)part_val_f32, n_tok * 64);
    AscendC::GlobalTensor<int32_t> gPi;  gPi.SetGlobalBuffer((__gm__ int32_t*)part_idx_i32, n_tok * 64);
    AscendC::GlobalTensor<int32_t> gOut; gOut.SetGlobalBuffer((__gm__ int32_t*)tok_out_i32, 8);

    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bPv, bPi, bOut;
    pipe.InitBuffer(bPv,  512 * sizeof(float));
    pipe.InitBuffer(bPi,  512 * sizeof(int32_t));
    pipe.InitBuffer(bOut, 8 * sizeof(int32_t));

    AscendC::LocalTensor<float>   lPv  = bPv.Get<float>();
    AscendC::LocalTensor<int32_t> lPi  = bPi.Get<int32_t>();
    AscendC::LocalTensor<int32_t> lOut = bOut.Get<int32_t>();

    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::DataCopy(lPv, gPv, n_tok * 64);
    AscendC::DataCopy(lPi, gPi, n_tok * 64);
    AscendC::PipeBarrier<PIPE_ALL>();

    __ubuf__ const float*   ppv  = (__ubuf__ const float*)lPv.GetPhyAddr();
    __ubuf__ const int32_t* ppi  = (__ubuf__ const int32_t*)lPi.GetPhyAddr();
    __ubuf__ int32_t*       pout = (__ubuf__ int32_t*)lOut.GetPhyAddr();
    for (int k = 0; k < 8; ++k) pout[k] = 0;

    for (uint32_t t = 0; t < n_tok; ++t) {
        float bv = -1e30f;
        int32_t bi = 0;
        for (uint32_t c = 0; c < 8; ++c) {
            float v = ppv[(t * 8 + c) * 8];
            int32_t idx = ppi[(t * 8 + c) * 8];
            if (v > bv || (v == bv && idx < bi)) { bv = v; bi = idx; }
        }
        pout[t] = bi;
    }
    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::DataCopy(gOut, lOut, 8);
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ============================================================================
// Host Launch Wrappers
// ============================================================================
namespace strata::ascend_ops {

void launch_f32_to_f16(void* stream, const void* src_f32, void* dst_f16, uint32_t n) {
    asc_f32_to_f16_kern<<<kNumCores, nullptr, stream>>>((uint8_t*)const_cast<void*>(src_f32), (uint8_t*)dst_f16, n);
}

void launch_f16_to_f32(void* stream, const void* src_f16, void* dst_f32, uint32_t n) {
    asc_f16_to_f32_kern<<<kNumCores, nullptr, stream>>>((uint8_t*)const_cast<void*>(src_f16), (uint8_t*)dst_f32, n);
}

void launch_gr_norm(void* stream, void* R, const void* bo, const void* inj, const void* w_norm,
                    void* xn_f32, void* xn_f16, uint32_t n_tok, uint32_t apply, float eps) {
    asc_gr_norm_kern<<<kNumCores, nullptr, stream>>>(
        (uint8_t*)R, (uint8_t*)const_cast<void*>(bo), (uint8_t*)const_cast<void*>(inj),
        (uint8_t*)const_cast<void*>(w_norm), (uint8_t*)xn_f32, (uint8_t*)xn_f16, n_tok, apply, eps);
}

void launch_gr_post_down(void* stream, const void* down_f16, void* lo_f16, void* inj_next_f32, uint32_t n_tok) {
    uint32_t n_pairs = (n_tok + 1) / 2;
    uint32_t blk = n_pairs < kNumCores ? (n_pairs > 0 ? n_pairs : 1) : kNumCores;
    asc_gr_post_down_kern<<<blk, nullptr, stream>>>(
        (uint8_t*)const_cast<void*>(down_f16), (uint8_t*)lo_f16, (uint8_t*)inj_next_f32, n_tok);
}

void launch_gr_post_up(void* stream, const void* xn_f32, const void* gate_f16, void* out_f16, void* out_f32, uint32_t n_tok) {
    asc_gr_post_up_kern<<<kNumCores, nullptr, stream>>>(
        (uint8_t*)const_cast<void*>(xn_f32), (uint8_t*)const_cast<void*>(gate_f16),
        (uint8_t*)out_f16, (uint8_t*)out_f32, n_tok);
}

void launch_gdn_step(void* stream, void* state_f32, const void* hist_in_f32, void* hist_out_f32,
                     const void* gdn_in_f16, void* qkv_save_f32, void* z_save_f32, void* ab_save_f32,
                     const void* conv_w_f32, const void* dt_f32, const void* ssm_a_f32, const void* gamma_f32,
                     void* yg_f16, uint32_t n_tok, uint32_t commit_at, uint32_t from_saved, float eps) {
    asc_gdn_step_kern<<<kNumCores, nullptr, stream>>>(
        (uint8_t*)state_f32, (uint8_t*)const_cast<void*>(hist_in_f32), (uint8_t*)hist_out_f32,
        (uint8_t*)const_cast<void*>(gdn_in_f16), (uint8_t*)qkv_save_f32, (uint8_t*)z_save_f32, (uint8_t*)ab_save_f32,
        (uint8_t*)const_cast<void*>(conv_w_f32), (uint8_t*)const_cast<void*>(dt_f32),
        (uint8_t*)const_cast<void*>(ssm_a_f32), (uint8_t*)const_cast<void*>(gamma_f32),
        (uint8_t*)yg_f16, n_tok, commit_at, from_saved, eps);
}

void launch_qsa_prep(void* stream, const void* qsa_in_f16,
                     const void* qn_f32, const void* kn_f32, const void* iqn_f32, const void* ikn_f32,
                     const void* rope_cs_f32,
                     void* qcur_f32, void* qgate_f32, void* qidx_f32,
                     void* kq_i8, void* vq_i8, void* ksc_f16, void* vsc_f16,
                     void* tail_f32, void* dead_f32, void* pooled_f32,
                     uint32_t pos0, uint32_t pos_base, uint32_t n_tok, float eps) {
    asc_qsa_prep_kern<<<kNumCores, nullptr, stream>>>(
        (uint8_t*)const_cast<void*>(qsa_in_f16),
        (uint8_t*)const_cast<void*>(qn_f32), (uint8_t*)const_cast<void*>(kn_f32),
        (uint8_t*)const_cast<void*>(iqn_f32), (uint8_t*)const_cast<void*>(ikn_f32),
        (uint8_t*)const_cast<void*>(rope_cs_f32),
        (uint8_t*)qcur_f32, (uint8_t*)qgate_f32, (uint8_t*)qidx_f32,
        (uint8_t*)kq_i8, (uint8_t*)vq_i8, (uint8_t*)ksc_f16, (uint8_t*)vsc_f16,
        (uint8_t*)tail_f32, (uint8_t*)dead_f32, (uint8_t*)pooled_f32,
        pos0, pos_base, n_tok, eps);
}

void launch_qsa_select(void* stream, const void* qidx_f32, const void* pooled_f32, const void* dead_f32,
                       void* scores_f32, void* qids_i32,
                       uint32_t pos0, uint32_t max_blocks_stride, uint32_t n_tok) {
    uint32_t blk = n_tok < kNumCores ? n_tok : kNumCores;
    asc_qsa_select_kern<<<blk, nullptr, stream>>>(
        (uint8_t*)const_cast<void*>(qidx_f32), (uint8_t*)const_cast<void*>(pooled_f32),
        (uint8_t*)const_cast<void*>(dead_f32), (uint8_t*)scores_f32, (uint8_t*)qids_i32,
        pos0, max_blocks_stride, n_tok);
}

void launch_qsa_attn_merge(void* stream, const void* qcur_f32, const void* qgate_f32,
                           const void* kq_i8, const void* vq_i8, const void* ksc_f16, const void* vsc_f16,
                           const void* qids_i32, void* xq_f16,
                           uint32_t pos0, uint32_t n_tok) {
    asc_qsa_attn_merge_kern<<<8, nullptr, stream>>>(
        (uint8_t*)const_cast<void*>(qcur_f32), (uint8_t*)const_cast<void*>(qgate_f32),
        (uint8_t*)const_cast<void*>(kq_i8), (uint8_t*)const_cast<void*>(vq_i8),
        (uint8_t*)const_cast<void*>(ksc_f16), (uint8_t*)const_cast<void*>(vsc_f16),
        (uint8_t*)const_cast<void*>(qids_i32), (uint8_t*)xq_f16,
        pos0, n_tok);
}

void launch_moe_route_shexp(void* stream, const void* moe_in_f16,
                            void* ids_i32, void* wts_f32, void* plan_i32,
                            void* sh_h_f16, void* sg_f32,
                            uint32_t n_tok, uint32_t n_expert) {
    asc_moe_route_shexp_kern<<<1, nullptr, stream>>>(
        (uint8_t*)const_cast<void*>(moe_in_f16),
        (uint8_t*)ids_i32, (uint8_t*)wts_f32, (uint8_t*)plan_i32,
        (uint8_t*)sh_h_f16, (uint8_t*)sg_f32, n_tok, n_expert);
}

void launch_moe_q2_gu(void* stream, const void* gu_qs, const void* gu_d,
                      const void* xf_f32, const void* plan_i32, void* h_f32, uint32_t n_tok) {
    asc_moe_q2_gu_kern<<<kNumCores, nullptr, stream>>>(
        (uint8_t*)const_cast<void*>(gu_qs), (uint8_t*)const_cast<void*>(gu_d),
        (uint8_t*)const_cast<void*>(xf_f32), (uint8_t*)const_cast<void*>(plan_i32),
        (uint8_t*)h_f32, n_tok);
}

void launch_moe_q2_down(void* stream, const void* down_qs, const void* down_d,
                        const void* h_f32, const void* plan_i32, void* ye_f32) {
    asc_moe_q2_down_kern<<<kNumCores, nullptr, stream>>>(
        (uint8_t*)const_cast<void*>(down_qs), (uint8_t*)const_cast<void*>(down_d),
        (uint8_t*)const_cast<void*>(h_f32), (uint8_t*)const_cast<void*>(plan_i32),
        (uint8_t*)ye_f32);
}

void launch_moe_combine(void* stream, const void* ye_f32, const void* plan_i32,
                        const void* ysh_f16, const void* sg_f32, void* bo_f32, uint32_t n_tok) {
    uint32_t blk = n_tok < kNumCores ? n_tok : kNumCores;
    asc_moe_combine_kern<<<blk, nullptr, stream>>>(
        (uint8_t*)const_cast<void*>(ye_f32), (uint8_t*)const_cast<void*>(plan_i32),
        (uint8_t*)const_cast<void*>(ysh_f16), (uint8_t*)const_cast<void*>(sg_f32),
        (uint8_t*)bo_f32, n_tok);
}

void launch_moe_route_cube(void* stream, const void* moe_in_f16,
                           void* ids_i32, void* wts_f32, void* sh_h_f16,
                           void* group_cumsum_i64, void* sorted_tok_i32, void* tok_perm_i32,
                           uint32_t n_tok, uint32_t n_expert) {
    uint32_t blk = n_tok < kNumCores ? n_tok : kNumCores;
    asc_moe_route_tok_kern<<<blk, nullptr, stream>>>(
        (uint8_t*)const_cast<void*>(moe_in_f16),
        (uint8_t*)ids_i32, (uint8_t*)wts_f32, (uint8_t*)sh_h_f16,
        (uint8_t*)group_cumsum_i64, (uint8_t*)tok_perm_i32,
        n_tok, n_expert);
    if (n_tok > 1u) {
        asc_moe_build_groups_kern<<<1, nullptr, stream>>>(
            (uint8_t*)ids_i32, (uint8_t*)group_cumsum_i64,
            (uint8_t*)sorted_tok_i32, (uint8_t*)tok_perm_i32,
            n_tok, n_expert);
    }
}

void launch_moe_gather_x(void* stream, const void* xf_f16, const void* sorted_tok_i32,
                         void* sorted_x_f16, uint32_t n_tok, uint32_t total_rows) {
    uint32_t blk = total_rows < kNumCores ? total_rows : kNumCores;
    asc_moe_gather_x_kern<<<blk, nullptr, stream>>>(
        (uint8_t*)const_cast<void*>(xf_f16), (uint8_t*)const_cast<void*>(sorted_tok_i32),
        (uint8_t*)sorted_x_f16, n_tok, total_rows);
}

void launch_moe_swiglu_f16(void* stream, const void* gu_f16, void* h_f16, uint32_t total_rows) {
    uint32_t n_tiles = (total_rows + 7) / 8;
    uint32_t blk = n_tiles < kNumCores ? (n_tiles > 0 ? n_tiles : 1) : kNumCores;
    asc_moe_swiglu_f16_kern<<<blk, nullptr, stream>>>(
        (uint8_t*)const_cast<void*>(gu_f16), (uint8_t*)h_f16, total_rows);
}

void launch_moe_combine_f16(void* stream, const void* ye_f16, const void* tok_perm_i32,
                            const void* wts_f32, const void* ysh_f16, void* bo_f32,
                            uint32_t n_tok, uint32_t total_rows) {
    uint32_t blk = n_tok < kNumCores ? n_tok : kNumCores;
    asc_moe_combine_f16_kern<<<blk, nullptr, stream>>>(
        (uint8_t*)const_cast<void*>(ye_f16), (uint8_t*)const_cast<void*>(tok_perm_i32),
        (uint8_t*)const_cast<void*>(wts_f32), (uint8_t*)const_cast<void*>(ysh_f16),
        (uint8_t*)bo_f32, n_tok, total_rows);
}

void launch_argmax_f16(void* stream, const void* logits_f16, void* part_val_f32, void* part_idx_i32,
                       void* tok_out_i32, uint32_t n_tok, uint32_t n_vocab) {
    asc_argmax_part_kern<<<8, nullptr, stream>>>(
        (uint8_t*)const_cast<void*>(logits_f16), (uint8_t*)part_val_f32, (uint8_t*)part_idx_i32, n_tok, n_vocab);
    asc_argmax_final_kern<<<1, nullptr, stream>>>(
        (uint8_t*)part_val_f32, (uint8_t*)part_idx_i32, (uint8_t*)tok_out_i32, n_tok);
}

}  // namespace strata::ascend_ops
